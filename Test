local EVENT_PROMPT_CAP = 400
local function eventFirePrompts(obj)
	if not obj then
		return 0
	end
	local fired = 0
	local seen = 0
	local function walk(node)
		if seen >= EVENT_PROMPT_CAP then
			return
		end
		local kids = node:GetChildren()
		for i = 1, #kids do
			if seen >= EVENT_PROMPT_CAP then
				return
			end
			seen += 1
			local k = kids[i]
			if k:IsA("ProximityPrompt") then
				promptInstant(k)
				fired += 1
			elseif k:IsA("Model") or k:IsA("Folder") then
				walk(k)
			end
		end
	end
	if obj:IsA("BasePart") then
		if obj:IsA("ProximityPrompt") then
			promptInstant(obj)
			fired += 1
		end
		return fired
	end
	walk(obj)
	return fired
end
