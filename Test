state.tapGui = function(button)
	if not button then
		return false
	end
	local okPos, x, y = pcall(function()
		return button.AbsolutePosition.X + button.AbsoluteSize.X / 2,
			button.AbsolutePosition.Y + button.AbsoluteSize.Y / 2
	end)
	if not okPos or type(x) ~= "number" or type(y) ~= "number" then
		return false
	end
	local pos = Vector2.new(x, y)
	if IS_MOBILE and VirtualInputManager then
		local down = pcall(function()
			VirtualInputManager:SendTouchEvent(1, pos, Enum.UserInputState.Begin)
		end)
		task.wait(0.02)
		local up = pcall(function()
			VirtualInputManager:SendTouchEvent(1, pos, Enum.UserInputState.End)
		end)
		if down and up then
			return true
		end
	end
	if VirtualInputManager then
		pcall(function()
			VirtualInputManager:SendMouseMoveEvent(x, y, game)
		end)
		task.wait(0.02)
		local down = pcall(function()
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, 1, game)
		end)
		task.wait(0.04)
		local up = pcall(function()
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, 1, game)
		end)
		if down and up then
			return true
		end
	end
	return false
end
local function pressButton(button, signalName)
	if not button then
		return 0
	end
	local signal = button[signalName]
	if typeof(signal) ~= "RBXScriptSignal" then
		return 0
	end
	local fired = 0
	local ok, connections = pcall(TMS.getConnections, signal)
	if not ok or type(connections) ~= "table" then
		return 0
	end
	for _, connection in ipairs(connections) do
		if pcall(function()
			connection:Fire()
		end) then
			fired = fired + 1
		end
	end
	return fired
end
local function pressEither(button)
	if state.tapGui(button) then
