do
	local AIM_BIND = "TMS_Aimbot"
	local bound = false
	local stick = nil
	local function lineClear(from, delta, dist, targetChar)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local list = { targetChar }
		local cam = workspace.CurrentCamera
		if cam then
			list[#list + 1] = cam
		end
		local mine = LocalPlayer.Character
		if mine then
			list[#list + 1] = mine
		end
		params.FilterDescendantsInstances = list
		return workspace:Raycast(from, delta, params) == nil
	end
	local function inCone(plr, cfg, cam)
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not hum or hum.Health <= 0 then
			return false, nil
		end
		local origin = cam.CFrame.Position
		local delta = root.Position - origin
		local dist = delta.Magnitude
		if dist <= 0.5 or dist > cfg.aimbotMaxDist then
			return false, nil
		end
		local fovCos = math.cos(math.rad(math.clamp(cfg.aimbotFov, 5, 360) / 2))
		local dot = cam.CFrame.LookVector:Dot(delta / dist)
		if dot < fovCos then
			return false, nil, nil
		end
		if cfg.aimbotVisibleOnly and not lineClear(origin, delta, dist, char) then
			return false, nil, nil
		end
		return true, dist, dot
	end
	local function pickTarget(cfg, cam)
		local best, bestScore = nil, -math.huge
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local ok, dist, dot = inCone(plr, cfg, cam)
				if ok then
					local score = dot * 1000 - dist * 0.001
					if score > bestScore then
						best, bestScore = plr, score
					end
				end
			end
		end
		return best
	end
	local function aimPoint(plr, cfg)
		local char = plr and plr.Character
		if not char then
			return nil
		end
		local part = cfg.aimbotHitHead and char:FindFirstChild("Head") or nil
		part = part or char:FindFirstChild("HumanoidRootPart")
		return part
	end
	local function drawCircle(cfg, cam)
		if not cfg.aimbotShowFov or not cam then
			if state.aimbotFovGui then
				state.aimbotFovGui.Enabled = false
			end
			return
		end
		local gui = state.aimbotFovGui
		if not (gui and gui.Parent) then
			gui = Instance.new("ScreenGui")
			gui.Name = "TMS_AimbotFov"
			gui.IgnoreGuiInset = true
			gui.DisplayOrder = 998
			gui.ResetOnSpawn = false
			local parentOk = pcall(function()
				gui.Parent = guiParent
			end)
			if not parentOk then
				gui.Parent = game:GetService("CoreGui")
			end
			local frame = Instance.new("Frame")
			frame.BackgroundTransparency = 1
			frame.BorderSizePixel = 0
			frame.AnchorPoint = Vector2.new(0.5, 0.5)
			frame.Position = UDim2.fromScale(0.5, 0.5)
			frame.Parent = gui
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = frame
			local stroke = Instance.new("UIStroke")
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			stroke.LineJoinMode = Enum.LineJoinMode.Round
			stroke.Parent = frame
			state.aimbotFovGui = gui
			state.aimbotFovFrame = frame
			state.aimbotFovStroke = stroke
		end
		local vp = cam.ViewportSize
		local half = math.rad(math.min(math.clamp(cfg.aimbotFov, 5, 360) / 2, 89.9))
		local fovRad = math.rad(math.max(1, cam.FieldOfView))
		local radius = (vp.Y / 2) * math.tan(half) / math.tan(fovRad / 2)
		radius = math.clamp(radius, 8, math.min(vp.X, vp.Y) / 2)
		local frame = state.aimbotFovFrame
		frame.Size = UDim2.fromOffset(radius * 2, radius * 2)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		local stroke = state.aimbotFovStroke
		stroke.Color = cfg.aimbotFovCircleColor
		stroke.Thickness = math.max(1, cfg.aimbotFovCircleThickness)
		gui.Enabled = true
	end
	local function aimTick(dt)
		local cfg = state.combat
		local cam = workspace.CurrentCamera
		drawCircle(cfg, cam)
		if not cfg.aimbot or not cam then
			return
		end
		if stick and stick ~= LocalPlayer then
			local stillGood = inCone(stick, cfg, cam)
			if not stillGood then
				stick = nil
			end
		else
			stick = nil
		end
		stick = stick or pickTarget(cfg, cam)
		local part = aimPoint(stick, cfg)
		if not part then
			return
		end
		local goal = CFrame.lookAt(cam.CFrame.Position, part.Position, cam.CFrame.UpVector)
		local alpha = 1 - math.exp(-math.max(cfg.aimbotSmooth, 0.01) * math.max(dt, 0.0001))
		cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(alpha, 0, 1))
	end
	local function start()
		if bound then
			return
		end
		bound = true
		RunService:BindToRenderStep(AIM_BIND, Enum.RenderPriority.Camera.Value + 1, aimTick)
	end
	local function stop()
		if bound then
			RunService:UnbindFromRenderStep(AIM_BIND)
			bound = false
		end
		stick = nil
		if state.aimbotFovGui then
			pcall(function()
				state.aimbotFovGui:Destroy()
			end)
			state.aimbotFovGui = nil
			state.aimbotFovFrame = nil
			state.aimbotFovStroke = nil
		end
	end
	local HITBOX_PARTS = {
		"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "Torso",
		"LeftUpperArm", "LeftLowerArm", "LeftHand", "Left Arm",
		"RightUpperArm", "RightLowerArm", "RightHand", "Right Arm",
		"LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "Left Leg",
		"RightUpperLeg", "RightLowerLeg", "RightFoot", "Right Leg",
	}
	local function hitbox(on)
		local cfg = state.combat
		cfg.hitbox = on
		if not on then
			for key, bak in pairs(cfg.hitboxBackup) do
				local plrName, partName = key:match("^(.-)%.(.*)$")
				local plr = plrName and Players:FindFirstChild(plrName)
				local char = plr and plr.Character
				local part = char and char:FindFirstChild(partName)
				if part and part:IsA("BasePart") then
					pcall(function()
						part.Size = bak.Size
						part.Transparency = bak.Transparency
					end)
				end
			end
			cfg.hitboxBackup = {}
			return
		end
		local scale = math.max(1, cfg.hitboxScale)
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local char = plr.Character
				if char then
					for _, partName in ipairs(HITBOX_PARTS) do
						local part = char:FindFirstChild(partName)
						if part and part:IsA("BasePart") then
							local key = plr.Name .. "." .. partName
							local bak = cfg.hitboxBackup[key]
							if not bak then
								bak = { Size = part.Size, Transparency = part.Transparency }
								cfg.hitboxBackup[key] = bak
							end
							pcall(function()
								part.Size = bak.Size * scale
								part.Transparency = cfg.hitboxTransparency
							end)
						end
					end
				end
			end
		end
	end
	state.aimbotStart = start
	state.aimbotStop = stop
	state.hitboxSet = hitbox
	local function sync()
		if state.combat.aimbot or state.combat.aimbotShowFov then
			start()
		else
			stop()
		end
	end
	state.aimbotSync = sync
end
