local function grabOne(entry)
	local handle = entry.handle
	if not isAlive(handle) then
		return false, "gone"
	end
	local prompt = chestPrompt(entry.model)
	if not prompt then
		return false, "notready"
	end
	if not prompt.Enabled then
		return false, "used"
	end
	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root or not isAlive(root) then
		return false, "no character"
	end
	local _, yaw = root.CFrame:ToEulerAnglesXYZ()
	root.CFrame = CFrame.new(handle.Position + Vector3.new(0, 0, 4)) * CFrame.Angles(0, yaw, 0)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	task.wait(pace(0.25))
	return fireChest(entry)
end
local function runLoop()
	if state.chest.running then
		return
	end
	state.chest.running = true
	local totalOk, sweeps = 0, 0
	while state.chest.autoCollect do
		sweeps = sweeps + 1
		local safe = collectChests()
		for _, entry in ipairs(safe) do
			if not state.chest.autoCollect then
				break
			end
			local char = LocalPlayer.Character
			if not char or not char:FindFirstChild("HumanoidRootPart") then
				break
			end
			local coord = G.__TMS_FARM_COORD
			if coord and (coord.doorsBusy or coord.doorsPending or coord.fragBusy) then
				task.wait(0.25)
				continue
			end
			local ok, success = pcall(grabOne, entry)
			if ok and success then
				totalOk = totalOk + 1
			end
			task.wait(pace(state.chest.delay))
		end
		if not state.chest.autoCollect then
			break
		end
		task.wait(pace(state.chest.rescanDelay))
	end
	state.chest.running = false
