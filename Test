local function fireChest(entry)
	local FIRE_ATTEMPTS = 3
	for attempt = 1, FIRE_ATTEMPTS do
		local live = chestPrompt(entry.model)
		if not live then
			state.debug.fireNoPrompt = (state.debug.fireNoPrompt or 0) + 1
			break
		end
		local armed = pcall(function()
			live.HoldDuration = 0
			live.MaxActivationDistance = 64
			live.RequiresLineOfSight = false
			live.Enabled = true
		end)
		if not armed then
			state.debug.fireArmFail = (state.debug.fireArmFail or 0) + 1
			break
		end
		pcall(FIRE_PROMPT, live)
		task.wait(FIRE_CONFIRM_WAIT)
		if not isAlive(entry.model) then
			state.debug.fireOk = (state.debug.fireOk or 0) + 1
			return true, "ok"
		end
	end
	state.debug.fireFail = (state.debug.fireFail or 0) + 1
	return false, "used"
