		if success == false then
			local detail = message
			if type(message) == "table" then
				detail = message.Message or message[1] or "unknown"
			end
			notify(
				"Server hop",
				"Roblox refused that server: " .. tostring(detail or result or "unknown reason")
					.. " Trying Rejoin fresh.",
				"alert-triangle"
			)
			rejoinFresh()
			return
		end
		notify("Server hop", "Hopping to server " .. tostring(target), "loader")
	end
	rejoinFresh = function()
