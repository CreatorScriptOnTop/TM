local dynamicChests = {}
local dynamicSeen = {}
local function noteDynamicChest(model)
	if dynamicSeen[model] or not looksLikeChest(model) then
		return false
	end
	dynamicSeen[model] = true
	dynamicChests[#dynamicChests + 1] = model
	return true
end
local chestWatchConn = nil
local function startChestWatcher()
	if chestWatchConn then
		return
	end
	chestWatchConn = workspace.DescendantAdded:Connect(function(inst)
		if noteDynamicChest(inst) then
			return
		end
		if inst:IsA("ProximityPrompt") then
			local top = inst
			while top.Parent and top.Parent ~= workspace do
				top = top.Parent
			end
			if top:IsA("Model") or top:IsA("BasePart") then
				task.defer(function()
					noteDynamicChest(top)
				end)
			end
		end
	end)
end
local function stopChestWatcher()
	if chestWatchConn then
		chestWatchConn:Disconnect()
		chestWatchConn = nil
	end
end
local function eachChest()
	local results = {}
	local claimed = {}
	local function consider(model, useSafeRadius)
		if claimed[model] then
			return
		end
		local part = chestPart(model)
		if not part then
			return
		end
		claimed[model] = true
		local blocked = isBlocked(part)
		if not blocked and not useSafeRadius then
			blocked = isHardBlocked(part)
		end
		results[#results + 1] = {
			model = model,
			handle = part,
			blocked = blocked,
			ready = chestPrompt(model) ~= nil,
		}
	end
	local folder = workspace:FindFirstChild(CHEST_FOLDER_NAME)
	if folder then
		for _, model in ipairs(folder:GetChildren()) do
			consider(model, true)
		end
	end
	for i = #dynamicChests, 1, -1 do
		local model = dynamicChests[i]
		if model.Parent == nil then
			table.remove(dynamicChests, i)
			dynamicSeen[model] = nil
		else
			consider(model, false)
		end
	end
	for _, model in ipairs(workspace:GetChildren()) do
		if model ~= folder and looksLikeChest(model) then
			consider(model, false)
		end
	end
	for _, wanted in ipairs(EXTRA_CHEST_NAMES) do
		local model = workspace:FindFirstChild(wanted)
		if model then
			consider(model, false)
		end
	end
	return results
end
local function pace(base)
	local scaled = base / (state.chest.speed or 1)
	if scaled < 0.03 then
		return 0.03
	end
	return scaled
end
local function isChestTool(tool)
	return tool:IsA("Tool") and string.find(string.lower(tool.Name), "chest", 1, true) ~= nil
end
local function chestToolSpent(tool)
	local used = tool:FindFirstChild("used")
	return used ~= nil and used:IsA("BoolValue") and used.Value == true
end
local function openChestTools()
	local char = LocalPlayer.Character
	if not char then
		return 0
	end
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local tools = {}
	local seen = {}
	for _, container in ipairs({ backpack, char }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if isChestTool(child) and not seen[child] and not chestToolSpent(child) then
					seen[child] = true
					tools[#tools + 1] = child
				end
			end
		end
	end
	local opened = 0
	for _, tool in ipairs(tools) do
		pcall(function()
			tool.Parent = char
		end)
		task.wait(pace(0.05))
		local ok = pcall(function()
			tool:Activate()
		end)
		if ok then
			opened = opened + 1
		end
		task.wait(pace(0.1))
	end
	return opened
end
