local function projectPoint(cam, proj, part)
	local cached = proj[part]
	if cached then
		return cached.x, cached.y, cached.z, cached.ok
	end
	local point, onScreen = cam:WorldToViewportPoint(part.Position)
	cached = { x = point.X, y = point.Y, z = point.Z, ok = onScreen }
	proj[part] = cached
	return cached.x, cached.y, cached.z, cached.ok
end
local function drawTarget(cfg, seen, proj, target, root, humanoid, displayName, category)
	if state.debug.drawn >= MAX_DRAWN_TARGETS then
		return false
	end
	local cam = workspace.CurrentCamera
	if not cam or not root or not root:IsA("BasePart") or not root.Parent then
		return false
	end
	local model = root:FindFirstAncestorOfClass("Model") or root.Parent
	if not model then
		return false
	end
	local origin = cam.CFrame.Position
	local dist = (root.Position - origin).Magnitude
	if dist > cfg.maxDist then
		return false
	end
	local sx, sy, sz, onScreen = projectPoint(cam, proj, root)
	if not onScreen or sz <= 0 then
		return false
	end
	local vp = cam.ViewportSize
	if sx < -80 or sx > vp.X + 80 or sy < -80 or sy > vp.Y + 80 then
		return false
	end
	local headPart = model:FindFirstChild("Head")
	local footPart = model:FindFirstChild("LeftFoot")
		or model:FindFirstChild("RightFoot")
		or model:FindFirstChild("LeftLowerLeg")
		or model:FindFirstChild("RightLowerLeg")
		or model:FindFirstChild("Left Leg")
		or model:FindFirstChild("Right Leg")
	local hy, hz, hon = sy - 30, sz, true
	local fy, fz, fon = sy + 30, sz, true
	if headPart then
		local _, py, pz, ok = projectPoint(cam, proj, headPart)
		hy, hz, hon = py, pz, ok
	end
	if footPart then
		local _, py, pz, ok = projectPoint(cam, proj, footPart)
		fy, fz, fon = py, pz, ok
	end
	if not hon or not fon or hz <= 0 or fz <= 0 then
		return false
	end
	local topY = math.min(hy, fy)
	local bottomY = math.max(hy, fy)
	local rawHeight = math.max(bottomY - topY, MIN_BOX_HEIGHT)
	local pad = rawHeight * 0.1
	local boxTop = topY - pad
	local boxHeight = rawHeight + pad * 2
	local width = math.clamp(boxHeight * 0.5, 14, 120)
	local cx = sx
	local boxLeft = cx - width / 2
	local boxBottom = boxTop + boxHeight
	local entry = acquire(target)
	if not entry then
		return false
	end
	local accent
	if category == "player" then
		accent = Color3.fromRGB(95, 205, 255)
	elseif category == "boss" then
		accent = Color3.fromRGB(255, 110, 95)
	else
		accent = Color3.fromRGB(255, 190, 110)
	end
	entry.container.Visible = true
	local roundedX = math.floor(boxLeft + 0.5)
	local roundedY = math.floor(boxTop + 0.5)
	local roundedW = math.floor(width + 0.5)
	local roundedH = math.floor(boxHeight + 0.5)
	entry.body.Position = UDim2.fromOffset(roundedX, roundedY)
	entry.body.Size = UDim2.fromOffset(roundedW, roundedH)
	if entry.accent ~= accent then
		entry.accent = accent
		entry.stroke.Color = accent
		for i = 1, #entry.brackets do
			entry.brackets[i].BackgroundColor3 = accent
		end
		entry.dot.BackgroundColor3 = accent
		entry.name.TextColor3 = accent
	end
	if cfg.box then
		if not entry.fill.Visible then
			entry.fill.Visible = true
		end
		for i = 1, #entry.brackets do
			if not entry.brackets[i].Visible then
				entry.brackets[i].Visible = true
			end
		end
	else
		if entry.fill.Visible then
			entry.fill.Visible = false
		end
		for i = 1, #entry.brackets do
			if entry.brackets[i].Visible then
				entry.brackets[i].Visible = false
			end
		end
	end
	if cfg.health and humanoid then
		if not entry.hpTrack.Visible then
			entry.hpTrack.Visible = true
			entry.hp.Visible = true
		end
		local hp = humanoid.Health
		local maxHp = math.max(humanoid.MaxHealth, 1)
		local pct = math.clamp(hp / maxHp, 0, 1)
		entry.hpTrack.Position = UDim2.fromOffset(0, roundedH + 4)
		entry.hpTrack.Size = UDim2.fromOffset(roundedW, 12)
		entry.hpFill.Size = UDim2.new(pct, 0, 1, 0)
		entry.hpFill.BackgroundColor3 = Color3.fromRGB(
			math.floor(255 * (1 - pct)),
			math.floor(255 * pct),
			80
		)
		entry.hp.Size = UDim2.fromScale(1, 1)
		entry.hp.Position = UDim2.fromOffset(0, 0)
		local hpNow = math.floor(hp)
		local hpMax = math.floor(maxHp)
		if entry.hpNow ~= hpNow or entry.hpMax ~= hpMax then
			entry.hpNow = hpNow
			entry.hpMax = hpMax
			entry.hp.Text = string.format("HP %d / %d", hpNow, hpMax)
		end
	elseif entry.hpTrack.Visible then
		entry.hpTrack.Visible = false
		entry.hp.Visible = false
	end
	if cfg.name then
		if not entry.tag.Visible then
			entry.tag.Visible = true
		end
		local shownName = tostring(displayName)
		if entry.nameText ~= shownName then
			entry.nameText = shownName
			entry.name.Text = shownName
		end
		local tagW = math.clamp(#shownName * 8 + 24, 64, 220)
		entry.tag.Position = UDim2.fromOffset(0, -20)
		entry.tag.Size = UDim2.fromOffset(tagW, 16)
		entry.name.Position = UDim2.fromOffset(20, 0)
		entry.name.Size = UDim2.fromOffset(tagW - 24, 16)
	elseif entry.tag.Visible then
		entry.tag.Visible = false
	end
	if cfg.distance then
		if not entry.dist.Visible then
			entry.dist.Visible = true
		end
		local distNow = math.floor(dist)
		if entry.distNow ~= distNow then
			entry.distNow = distNow
			entry.dist.Text = string.format("%d studs", distNow)
		end
		entry.dist.Position = UDim2.fromOffset(0, roundedH + 18)
		entry.dist.Size = UDim2.fromOffset(roundedW, 12)
	elseif entry.dist.Visible then
		entry.dist.Visible = false
	end
	if cfg.skeleton and dist <= SKELETON_MAX_DIST then
		local bones = bonePartsFor(model)
		if entry.boneModel ~= model or not entry.boneRefs or #entry.boneRefs ~= #bones or entry.boneMissing then
			local refs = {}
			local missing = false
			for i = 1, #bones do
				local partA = model:FindFirstChild(bones[i][1])
				local partB = model:FindFirstChild(bones[i][2])
				if not (partA and partB) then
					missing = true
				end
				refs[i] = { partA, partB }
			end
			entry.boneModel = model
			entry.boneRefs = refs
			entry.boneMissing = missing
		end
		local refs = entry.boneRefs
		for i = 1, #bones do
			local line = createBone(entry, i)
			local pair = refs[i]
			local partA, partB = pair[1], pair[2]
			local shown = false
			if partA and partB and partA.Parent and partB.Parent then
				local ax, ay, az, onA = projectPoint(cam, proj, partA)
				local bx, by, bz, onB = projectPoint(cam, proj, partB)
				if onA and onB and az > 0 and bz > 0 then
					local dx = bx - ax
					local dy = by - ay
					local len = math.sqrt(dx * dx + dy * dy)
					if len >= 1 then
						if not line.Visible then
							line.Visible = true
						end
						if line.BackgroundColor3 ~= accent then
							line.BackgroundColor3 = accent
						end
						line.Position = UDim2.fromOffset(ax, ay)
						line.Size = UDim2.new(0, 1, 0, len)
						line.Rotation = math.deg(math.atan2(dx, dy))
						shown = true
					end
				end
			end
			if not shown and line.Visible then
				line.Visible = false
			end
		end
		for i = #bones + 1, #entry.bones do
			if entry.bones[i].Visible then
				entry.bones[i].Visible = false
			end
		end
	else
		for i = 1, #entry.bones do
			if entry.bones[i].Visible then
				entry.bones[i].Visible = false
			end
		end
	end
	seen[target] = true
	state.debug.drawn = state.debug.drawn + 1
	return true
end
