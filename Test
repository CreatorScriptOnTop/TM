	end
	local function rememberSafe(found, root)
		local pos = root.Position
		if math.abs(pos.X) > 2800 or math.abs(pos.Z) > 2800
			or pos.Y < -20 or pos.Y > 300 or mazeActive() then
			return
		end
		local _, watcherDist = closest(found.WATCHER, pos)
		if watcherDist < FLEE_RANGE then
			return
		end
		state.chest.monsterSafeCFrame = root.CFrame
	end
	local function namedSafe(watcher)
		local best, bestDist = nil, -1
		local function consider(obj)
			if not obj then
				return
			end
			local part = TMS_EVENT_KEEP.eventPart(obj)
			if not part or not part.Parent then
				return
			end
			local p = part.Position
			if math.abs(p.X) > 3000 or math.abs(p.Z) > 3000 then
				return
			end
			local dist = watcher and (p - watcher.Position).Magnitude or 0
			if dist > bestDist then
				best, bestDist = part, dist
			end
		end
		consider(LocalPlayer.RespawnLocation)
		consider(workspace:FindFirstChild("SpawnLocation"))
		consider(workspace:FindFirstChild("Spawn"))
		consider(workspace:FindFirstChild("SpawnPoint"))
