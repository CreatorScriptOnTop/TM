local function openShop(timeoutSeconds)
	markSell("open-start")
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil, "no character"
	end
	local mapFolder = workspace:FindFirstChild("Map folder")
	local seller = mapFolder and mapFolder:FindFirstChild("Seller")
	local npc = seller and seller:FindFirstChild("Liltroll")
	if not npc then
		local lilTroll = workspace:FindFirstChild("lil troll")
		npc = lilTroll and lilTroll:FindFirstChild("Liltroll")
	end
	if not npc then
		return nil, "the seller is not loaded"
	end
	local part = npc:IsA("BasePart") and npc or npc:FindFirstChildWhichIsA("BasePart", true)
	if part then
		pcall(function()
			root.CFrame = part.CFrame + Vector3.new(0, 3, 0)
		end)
		task.wait(0.25)
	end
	local prompt
	for _, d in ipairs(npc:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			prompt = d
			break
		end
	end
	if not prompt then
		return nil, "the seller has no prompt"
	end
	pcall(function()
		prompt.HoldDuration = 0
		prompt.RequiresLineOfSight = false
	end)
	local stale = LocalPlayer.PlayerGui:FindFirstChild("Shopguis")
	if stale then
		local staleFrame = stale:FindFirstChild("MainsFrame")
		if staleFrame then
			closeShop(staleFrame)
		end
		if LocalPlayer.PlayerGui:FindFirstChild("Shopguis") then
			pcall(function()
				stale:Destroy()
			end)
		end
		task.wait(0.2)
	end
	-- One prompt fire right after teleport is sometimes ignored by the game
	-- (the character is still settling). Retry until the GUI actually appears.
	local deadline = os.clock() + (timeoutSeconds or 8)
	local attempt = 0
	while os.clock() < deadline do
		attempt = attempt + 1
		markSell("open-prompt", attempt)
		pcall(FIRE_PROMPT, prompt)
		for _ = 1, 6 do
			local gui = LocalPlayer.PlayerGui:FindFirstChild("Shopguis")
			local frame = gui and gui:FindFirstChild("MainsFrame")
			if frame then
				local ok, enabled = pcall(function()
					return gui.Enabled
				end)
				if ok and enabled and frame.Visible then
					markSell("open-got")
					return frame
				end
			end
			task.wait(0.15)
		end
	end
	return nil, "the shop did not open"
end
local function fireTabButton(button)
	if not button then
		return false
	end
	-- Synthetic touch is ignored on Delta and raw :Fire() runs the game's
	-- handler on our thread (it hangs in the typewriter). Native
	-- SelectedObject + Enter is the path that reliably activates shop buttons.
	pcall(function()
		GuiService.SelectedObject = button
	end)
	task.wait(0.12)
	pressEnter()
	task.wait(0.15)
	return true
end
function closeShop(main)
	markSell("close-enter")
	local gui = LocalPlayer.PlayerGui:FindFirstChild("Shopguis")
	if not gui then
		markSell("close-no-gui")
		return true
	end
	local frame = main or gui:FindFirstChild("MainsFrame")
	local buttons = frame and frame:FindFirstChild("ButtonSelections")
	local closeButton = buttons and buttons:FindFirstChild("Button5")

	-- Walk ancestors so a button inside a hidden dialog is not mistaken for a
	-- live close target. ScreenGui uses Enabled, GuiObject uses Visible.
	local function shopWidgetVisible(obj)
		local node = obj
		while typeof(node) == "Instance" and node ~= LocalPlayer.PlayerGui do
			if node:IsA("LayerCollector") then
				local ok, enabled = pcall(function()
					return node.Enabled
				end)
				if ok and enabled == false then
					return false
				end
			elseif node:IsA("GuiObject") then
				local ok, visible = pcall(function()
					return node.Visible
				end)
				if ok and visible == false then
					return false
				end
			end
			node = node.Parent
		end
		return true
	end

	-- We never hide the GUI ourselves anymore, so a hidden MainsFrame really
	-- does mean the shop's own Button5 closed it.
	local function shopClosed()
		local currentGui = LocalPlayer.PlayerGui:FindFirstChild("Shopguis")
		if not currentGui then
			return true
		end
		local okEnabled, enabled = pcall(function()
			return currentGui.Enabled
		end)
		if okEnabled and enabled == false then
			return true
		end
		local currentFrame = currentGui:FindFirstChild("MainsFrame")
		if not currentFrame then
			return true
		end
		local okVisible, visible = pcall(function()
			return currentFrame.Visible
		end)
		return okVisible and visible == false
	end

	-- Always fire the Lua connections. Synthetic taps report success without
	-- actually activating the button on touch, which left the shop logically
	-- open and stole the camera afterwards.
	local function fireClose(btn)
		if not btn then
			return 0
		end
		local down = pressButton(btn, "MouseButton1Down")
		local click = pressButton(btn, "MouseButton1Click")
		if click == 1 then
			click = click + pressButton(btn, "MouseButton1Click")
		end
		if down == 0 and click == 0 then
			pcall(function()
				btn:Activate()
			end)
			TMS.fireSignal(btn.MouseButton1Click)
		end
		return down + click
	end

	local function closeCandidates()
		local out = {}
		if closeButton then
			out[#out + 1] = closeButton
		end
		if frame then
			pcall(function()
				for _, obj in ipairs(frame:GetDescendants()) do
					if typeof(obj) == "Instance" and obj:IsA("GuiButton") then
						local text = ""
						if obj:IsA("TextButton") then
							pcall(function()
								text = tostring(obj.Text or "")
							end)
						end
						local label = string.upper(tostring(obj.Name) .. " " .. text)
						if string.find(label, "CLOSE", 1, true)
							or string.find(label, "EXIT", 1, true)
							or string.find(label, "BACK", 1, true)
							or string.find(label, "CANCEL", 1, true) then
							out[#out + 1] = obj
						end
					end
				end
			end)
		end
		return out
	end

	-- Find the buttons that are actually on screen right now. After a sale the
	-- shop swaps dialogs, so the live Quit button is often NOT under MainsFrame.
	local function findShopButtons()
		local found = {}
		local roots = {}
		if typeof(gui) == "Instance" and gui.Parent then
			roots[#roots + 1] = gui
		end
		-- Do not name-filter: the exit buttons can live in a dialog ScreenGui
		-- with any name. Only skip ScreenGuis we created ourselves.
		pcall(function()
			for _, child in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
				if typeof(child) == "Instance" and child:IsA("LayerCollector")
					and child ~= gui then
					local name = string.upper(tostring(child.Name))
					if not string.find(name, "TMS", 1, true) then
						roots[#roots + 1] = child
					end
				end
			end
		end)
		for _, root in ipairs(roots) do
			pcall(function()
				for _, obj in ipairs(root:GetDescendants()) do
					if typeof(obj) == "Instance" and obj:IsA("GuiButton")
						and shopWidgetVisible(obj) then
						local text = ""
						if obj:IsA("TextButton") then
							pcall(function()
								text = tostring(obj.Text or "")
							end)
						end
						found[#found + 1] = {
							button = obj,
							label = string.upper(tostring(obj.Name) .. " " .. text),
						}
					end
				end
			end)
		end
		return found
	end

	local function exitRank(label)
		if string.find(label, "QUIT", 1, true)
			or string.find(label, "EXIT", 1, true)
			or string.find(label, "CLOSE", 1, true) then
			return 3
		end
		if string.find(label, "BACK", 1, true)
			or string.find(label, "CANCEL", 1, true) then
			return 2
		end
		return 0
	end

	-- One press only. Firing both Down and Click on a dialog button can run its
	-- handler twice and bounce us back into the shop.
	local function fireNav(btn)
		if not btn then
			return 0
		end
		local fired = pressButton(btn, "MouseButton1Click")
		if fired == 0 then
			fired = pressButton(btn, "MouseButton1Down")
		end
		if fired == 0 then
			pcall(function()
				btn:Activate()
			end)
			TMS.fireSignal(btn.MouseButton1Click)
			fired = 1
		end
		return fired
	end

	-- Press every real exit/back button once. Stopping at the first one left a
	-- second Exit still holding the player at the NPC with no GUI on screen.
	local function walkExitButtons()
		local fired = {}
		local trace = {}
		local scan = {}
		for _ = 1, 12 do
			if shopClosed() then
				break
			end
			local entries = findShopButtons()
			if #scan == 0 then
				for _, entry in ipairs(entries) do
					local clicks, downs = 0, 0
					pcall(function()
						clicks = #TMS.getConnections(entry.button.MouseButton1Click)
					end)
					pcall(function()
						downs = #TMS.getConnections(entry.button.MouseButton1Down)
					end)
					scan[#scan + 1] = entry.label .. " [click=" .. clicks
						.. ",down=" .. downs .. "]"
				end
			end
			local chosen, chosenLabel, chosenKey = nil, "", nil
			for rank = 3, 2, -1 do
				for _, entry in ipairs(entries) do
					local key = entry.button:GetFullName()
					if exitRank(entry.label) == rank and not fired[key] then
						chosen = entry.button
						chosenLabel = entry.label
						chosenKey = key
						break
					end
				end
				if chosen then
					break
				end
			end
			if not chosen then
				break
			end
			fired[chosenKey] = true
			trace[#trace + 1] = chosenLabel .. " -> " .. tostring(chosen.Name)
			fireNav(chosen)
			task.wait(IS_MOBILE and 0.3 or 0.2)
		end
		pcall(function()
			G.__TMS_SHOP_CLOSE = G.__TMS_SHOP_CLOSE or {}
			G.__TMS_SHOP_CLOSE.scan = scan
		end)
		return trace
	end

	local function skipDialogs()
		for _, name in ipairs({ "SkipDialogs", "Skiptext", "SkipText", "DialogFrame" }) do
			local obj = gui:FindFirstChild(name, true)
			if typeof(obj) == "Instance" then
				if obj:IsA("GuiButton") then
					fireClose(obj)
				elseif obj:IsA("BoolValue") then
					pcall(function()
						obj.Value = true
					end)
				end
			end
		end
	end

	local function notifyServer()
		pcall(function()
			local rs = game:GetService("ReplicatedStorage")
			local remote = rs and rs:FindFirstChild("CloseShopEvent")
			if typeof(remote) == "Instance" and remote:IsA("RemoteEvent") then
				remote:FireServer()
			end
		end)
	end

	local function restoreControls()
		pcall(function()
			GuiService.SelectedObject = nil
		end)
		pcall(function()
			local cam = workspace.CurrentCamera
			if cam then
				cam.CameraType = Enum.CameraType.Custom
				cam.CameraMode = Enum.CameraMode.Classic
			end
			LocalPlayer.CameraMode = Enum.CameraMode.Classic
		end)
		pcall(function()
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.CameraOffset = Vector3.zero
				if hum.WalkSpeed < 1 and not state.localMods.fly then
					hum.WalkSpeed = state.localMods.speed and state.localMods.speedValue or 16
				end
			end
		end)
	end

	local navTrace = {}
	-- Same path on PC and touch: wait out the typewriter, then activate the
	-- real close button through Roblox's native selection. Flipping
	-- SkipDialogs or calling :Fire() on the handler both abort the typewriter.
	waitForSellerDialog(gui)
	markSell("close-wait-done")
	task.wait(0.15)
	navTrace = walkExitButtons()
	markSell("close-nav-done")
	if closeButton then
		for attempt = 1, 4 do
			if shopClosed() then
				break
			end
			markSell("close-select", attempt)
			navTrace[#navTrace + 1] = "Button5 select+enter"
			pcall(function()
				GuiService.SelectedObject = closeButton
			end)
			task.wait(0.12)
			pressEnter()
			task.wait(0.2)
		end
	end
	markSell("close-taps-done")
	-- Give the game time to finish its own exit before deciding it failed.
	for _ = 1, 12 do
		if shopClosed() then
			break
		end
		task.wait(0.15)
	end
	notifyServer()
	markSell("close-diag")
	pcall(function()
		G.__TMS_SHOP_CLOSE = G.__TMS_SHOP_CLOSE or {}
		local texts = {}
		pcall(function()
			for _, obj in ipairs(gui:GetDescendants()) do
				if typeof(obj) == "Instance"
					and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
					local text = tostring(obj.Text or "")
					if text ~= "" then
						texts[#texts + 1] = tostring(obj.Name) .. "=" .. text
					end
				end
			end
		end)
		G.__TMS_SHOP_CLOSE.last = {
			fired = navTrace,
			closed = shopClosed(),
			texts = texts,
		}
	end)

	-- Never hide or destroy the shop ourselves: pre-empting the game's own
	-- Exit leaves the character held at the NPC.
	restoreControls()
	return shopClosed()
end
local function runSellOnce()
	markSell("sell-start")
	if #ownedSellItems() == 0 then
		return false, "you do not own any of the six cups"
	end
	local main, err = openShop(8)
	if not main then
		markSell("sell-open-failed", err)
		return false, err or "could not reach the shop"
	end
	markSell("sell-opened")
	local sold, failed = {}, {}
	local attempted = 0
	local ok, message = pcall(function()
		local buttons = main:FindFirstChild("ButtonSelections")
		local sellFrame = main:FindFirstChild("SellSelections")
		if not (buttons and sellFrame) then
			error("the shop is missing its sell tab")
		end
		-- The seller types its greeting when the shop opens. Any input before
		-- it finishes aborts the typewriter at the first letter.
		waitForSellerDialog(main)
		task.wait(0.15)
		markSell("sell-tab-firing")
		local function waitSellTab(seconds)
			local deadline = os.clock() + seconds
			while os.clock() < deadline do
				if sellFrame.Visible then
					return true
				end
				task.wait(0.1)
			end
			return sellFrame.Visible
		end
		fireTabButton(buttons:FindFirstChild("Button2"))
		markSell("sell-tab-fired")
		if not waitSellTab(0.5) then
			for _ = 1, 3 do
				fireTabButton(buttons:FindFirstChild("Button2"))
				if waitSellTab(0.5) then
					break
				end
			end
		end
		if not sellFrame.Visible then
			markSell("sell-tab-failed")
			error("the sell tab would not open")
		end
		markSell("sell-tab-open")
		local scroll = sellFrame:FindFirstChild("ScrollingFrame")
		local shop = sellFrame:FindFirstChild("MainShop")
		if not (scroll and shop) then
			error("the sell tab has no item list")
		end
		local label = shop:FindFirstChild("ItemSelection")
		local function selectedText()
			local text = ""
			if label then
				pcall(function()
					text = label.Text or ""
				end)
			end
			return text
		end
		-- Let the seller finish typing before selecting anything.
		waitForSellerDialog(main)
		task.wait(0.15)
		markSell("sell-items-loop")
		for _, name in ipairs(SELL_ITEMS) do
			if not ownedOne(name) then
				continue
			end
			markSell("sell-item", name)
			local button = scroll:FindFirstChild(name)
			if not button then
				failed[#failed + 1] = name .. " (no button)"
				continue
			end
			attempted = attempted + 1
			local before = ownedCount(name)
			local prevPicked = selectedText()
			selectWith(button)
			local picked = prevPicked
			local pickDeadline = os.clock() + 0.7
			while os.clock() < pickDeadline do
				picked = selectedText()
				if picked ~= prevPicked then
					break
				end
				task.wait(0.1)
			end
			if picked == "" or picked == "Nothing" then
				failed[#failed + 1] = name .. " (no selection)"
				continue
			end
			local sellall = shop:FindFirstChild("Sellall")
			local sell = shop:FindFirstChild("Sell")
			if sellall then
				selectWith(sellall)
			end
			if sell then
				selectWith(sell)
			end
			local saleDeadline = os.clock() + 0.8
			while os.clock() < saleDeadline do
				if ownedCount(name) < before then
					break
				end
				task.wait(0.1)
			end
			if ownedCount(name) < before then
				sold[#sold + 1] = string.format("%s x%d", name, before - ownedCount(name))
			else
				failed[#failed + 1] = name .. " (nothing sold)"
			end
		end
	end)
	markSell("sell-loop-end", ok and "ok" or tostring(message))
	closeShop(main)
	markSell("sell-after-close")
	if not ok then
		return false, tostring(message)
	end
	if #sold == 0 then
		return false, string.format(
			"reached the sell tab and priced %d item(s), but no sale went through%s",
			attempted,
			#failed > 0 and (" - " .. table.concat(failed, ", ")) or ""
		)
	end
	return true, string.format("sold %s", table.concat(sold, ", "))
end
