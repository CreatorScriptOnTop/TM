local function runMazeExit()
	if state.chest.mazeRunning then
		return
	end
	state.chest.mazeRunning = true
	local sawMaze = false
	local usedExit = false
	local bound = false
	local function applyMazeExit()
		local part = state.mazeExitHoldPart
		local root = TMS_EVENT_KEEP.eventRoot()
		if not part or not part.Parent or not root or not root.Parent then
			return
		end
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = part.CFrame
		end)
	end
	while state.chest.mazeExit do
		local char = LocalPlayer.Character
		local flag = char and char:FindFirstChild("Mazestuff")
		local caught = flag ~= nil and flag.Value == true
		if TMS_EVENT_KEEP.mazeIsActive() or caught then
			sawMaze = true
			local folder = workspace:FindFirstChild("Maze")
			local exitObj = folder and folder:FindFirstChild("Exit")
			local part = exitObj and TMS_EVENT_KEEP.eventPart(exitObj) or nil
			if part and part.Parent then
				usedExit = true
				state.mazeExitHoldPart = part
				if not bound then
					pcall(function()
						RunService:UnbindFromRenderStep("TMSMazeExitRun")
					end)
					bound = pcall(function()
						RunService:BindToRenderStep("TMSMazeExitRun", Enum.RenderPriority.Camera.Value + 3, applyMazeExit)
					end) == true
				end
				applyMazeExit()
			end
		elseif sawMaze then
			break
		end
		task.wait(TMS_EVENT_KEEP.MAZE_POLL)
	end
	if bound then
		pcall(function()
			RunService:UnbindFromRenderStep("TMSMazeExitRun")
		end)
	end
	state.mazeExitHoldPart = nil
	state.chest.mazeRunning = false
	notify(
		"Maze Exit",
		usedExit and "Used workspace.Maze.Exit."
			or (sawMaze and "workspace.Maze.Exit was not present; waited for the maze to end."
				or "No maze was active."),
		usedExit and "check" or "shield"
	)
end
local watcherFled = {}
local EXIT_BIND = "TMSMonsterCounterExit"
local exitHoldPart = nil
local exitBound = false
local function applyExit()
	local part = exitHoldPart
	local root = TMS_EVENT_KEEP.eventRoot()
	if not part or not part.Parent or not root or not root.Parent then
		return
	end
	pcall(function()
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = part.CFrame
	end)
end
local function releaseExit()
	if exitBound then
		pcall(function()
			RunService:UnbindFromRenderStep(EXIT_BIND)
		end)
		exitBound = false
	end
	exitHoldPart = nil
end
local function holdExit(part)
	if not part or not part.Parent then
		return false
	end
	exitHoldPart = part
	if not exitBound then
		pcall(function()
			RunService:UnbindFromRenderStep(EXIT_BIND)
		end)
		local ok = pcall(function()
			RunService:BindToRenderStep(EXIT_BIND, Enum.RenderPriority.Camera.Value + 3, applyExit)
		end)
		exitBound = ok == true
	end
	applyExit()
