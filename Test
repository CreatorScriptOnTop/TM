-- The seller types every line one character at a time ("Want to sell
-- something?", then a different line after the sale). Any synthetic touch
-- while a line is typing aborts the typewriter and leaves it stuck at the
-- first letter ("W" / "H"). Watch the actual Text properties so we can move
-- as soon as typing stops instead of burning a fixed 5 seconds every time.
-- If typing has not started at all, still wait long enough to catch a late
-- line before giving up.
local function waitForSellerDialog(root)
	markSell("dialog-wait-enter")
	if not root then
		return true
	end
	local conns = {}
	local start = os.clock()
	local lastChange = start
	local seenChange = false
	pcall(function()
		for _, obj in ipairs(root:GetDescendants()) do
			if typeof(obj) == "Instance"
				and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
				conns[#conns + 1] = obj:GetPropertyChangedSignal("Text"):Connect(function()
					lastChange = os.clock()
					seenChange = true
				end)
			end
		end
	end)
	while os.clock() - start < 6.5 do
		task.wait(0.1)
		local quiet = os.clock() - lastChange
		if seenChange and quiet >= 0.35 then
			break
		end
		if not seenChange and quiet >= 6.0 then
			break
		end
	end
	for _, conn in ipairs(conns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	markSell(seenChange and "dialog-wait-adaptive" or "dialog-wait-timeout")
	return true
end

