	end
	local function retreatFrom(watcher, root)
		local dir = root.Position - watcher.Position
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude < 0.001 then
			dir = Vector3.new(1, 0, 0)
		end
		dir = dir.Unit
		local dest = root.Position + dir * 180
		if dest.X > 2800 then dest.X = 2800 elseif dest.X < -2800 then dest.X = -2800 end
		if dest.Z > 2800 then dest.Z = 2800 elseif dest.Z < -2800 then dest.Z = -2800 end
		local ok = pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = CFrame.lookAt(dest, dest + dir)
		end)
		return ok
