local EVENT_HOSTILE_CAP = 80
local EVENT_RESPAWN_TIMEOUT = 90
local function eventRoot()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end
local function eventPart(obj)
	if not obj then
		return nil
	end
	if obj:IsA("BasePart") then
		return obj
	end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end
local function eventTpTo(obj, allowOffMap)
	if not obj then
		return false
	end
	local part = eventPart(obj)
	if not part then
		return false
	end
	local root = eventRoot()
	if not root then
		return false
	end
	if not allowOffMap then
		local p = part.Position
		if math.abs(p.X) > 3000 or math.abs(p.Z) > 3000 then
			state.chest.trace = state.chest.trace or {}
			table.insert(state.chest.trace,
				"refused off-map tp to " .. string.format("%.0f,%.0f,%.0f", p.X, p.Y, p.Z))
			return false
		end
	end
	for i = 1, EVENT_TP_ATTEMPTS do
		local ok = pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = part.CFrame + EVENT_SAFESPOT_HOLD
		end)
		if not ok then
			return false
		end
		if i < EVENT_TP_ATTEMPTS then
			task.wait(EVENT_TP_SETTLE)
		end
	end
	return true
end
state.eventTpTo = eventTpTo
local function eventIsSelf(m)
	local char = LocalPlayer.Character
	if not char then
		return false
	end
	if m == char then
		return true
	end
	if m:IsDescendantOf(char) then
		return true
	end
	local charRoot = char:FindFirstChild("HumanoidRootPart")
	if not charRoot then
		return false
	end
	local mRoot = m:FindFirstChild("HumanoidRootPart")
	if mRoot and mRoot == charRoot then
		return true
	end
	local mHum = m:FindFirstChildOfClass("Humanoid")
	if mHum and not m:IsDescendantOf(char) then
		local mBase = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
		if mBase and (mBase.Position - charRoot.Position).Magnitude < 0.5 and char:FindFirstChildOfClass("Humanoid") then
			return true
		end
	end
	return false
end
local function eventHostilesNear()
	local root = eventRoot()
	if not root then
		return 0
	end
	local n = 0
	local kids = workspace:GetChildren()
	for i = 1, #kids do
		if n >= EVENT_HOSTILE_CAP then
			break
		end
		local m = kids[i]
		if m:IsA("Model") and not eventIsSelf(m) then
			local hm = m:FindFirstChildOfClass("Humanoid")
			if hm and hm.Health > 0 then
				local mp = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
				if mp and (root.Position - mp.Position).Magnitude <= EVENT_FLEE_RANGE then
					n += 1
				end
			end
		end
	end
	return n
end
local function eventHealth()
	local char = LocalPlayer.Character
	local h = char and char:FindFirstChildOfClass("Humanoid")
	if not h then
		return nil
	end
	return h.Health
end
local function eventMonsterPause()
	if not state.chest.monsterCounterRunning then
		return
	end
	local waited = 0
	while state.chest.autoDebugEvent
		and state.chest.monsterCounterRunning
		and state.chest.monsterActive
		and waited < 12 do
		task.wait(EVENT_POLL)
		waited += EVENT_POLL
	end
	if waited >= 12 and state.chest.monsterActive then
		state.debug.monsterPauseSkips = (state.debug.monsterPauseSkips or 0) + 1
	end
end
local function eventShouldAbort()
	if not state.chest.autoDebugEvent then
		return true
	end
	eventMonsterPause()
	local hp = eventHealth()
	if hp ~= nil and hp <= 0 then
		return true
	end
	if hp ~= nil and hp < EVENT_FLEE_HP and eventHostilesNear() > 0 then
		notify(
			"Auto Debug World",
			string.format("Stopped at %d hp with something nearby.", math.floor(hp)),
			"alert-triangle"
		)
		return true
	end
	return false
end
local function eventWaitAlive()
	local waited = 0
	while waited < EVENT_RESPAWN_TIMEOUT do
		if not state.chest.autoDebugEvent then
			return false
		end
		local hp = eventHealth()
		if hp ~= nil and hp > 0 then
			return true
		end
		task.wait(0.5)
		waited += 0.5
	end
	return false
end
local function eventHoldOn(obj, seconds)
	local target = eventPart(obj)
	if not target then
		return false
	end
	local elapsed = 0
	while elapsed < seconds do
		if not eventWaitAlive() then
			return false
		end
		if eventShouldAbort() then
			return false
		end
		local root = eventRoot()
		if root and root.Parent then
			pcall(function()
				root.AssemblyLinearVelocity = Vector3.zero
				root.CFrame = target.CFrame + EVENT_SAFESPOT_HOLD
			end)
		else
			return false
		end
		task.wait(EVENT_POLL)
		elapsed += EVENT_POLL
	end
	return true
end
local ENTITY_POLL = 0.1
local ENTITY_TOUCH_SETTLE = 0.5
local function entityNormalize(name)
	return (string.upper(name):gsub("[^A-Z0-9]", ""))
end
local ENTITY_NO_HOPE = { NOHOPE = true, NOHOP = true }
local function entityFindNoHope()
	local kids = workspace:GetChildren()
	for i = 1, #kids do
		local m = kids[i]
		if m:IsA("Model") and not eventIsSelf(m) then
			if ENTITY_NO_HOPE[entityNormalize(m.Name)] then
				local hm = m:FindFirstChildOfClass("Humanoid")
				if hm and hm.Health > 0 then
					return m, eventPart(m)
				end
			end
		end
	end
	return nil, nil
end
local function runEntityGuard()
	if state.chest.entityGuardRunning then
		return
	end
	state.chest.entityGuardRunning = true
	local touches = 0
	local seenAny = false
	while state.chest.entityGuard do
		local ok, model, base = pcall(entityFindNoHope)
		if ok and model and base then
			seenAny = true
			local root = eventRoot()
			if root then
				pcall(function()
					root.AssemblyLinearVelocity = Vector3.zero
					root.CFrame = base.CFrame
				end)
			end
			task.wait(ENTITY_TOUCH_SETTLE)
			touches += 1
		else
			task.wait(ENTITY_POLL)
		end
	end
	state.chest.entityGuardRunning = false
	notify(
		"Entity Guard",
		seenAny and string.format("Touched NO_HOPE %d time(s).", touches) or "No NO_HOPE seen.",
		seenAny and "check" or "shield"
	)
end
local MAZE_POLL = 0.1
local function mazeIsActive()
	local folder = workspace:FindFirstChild("Maze")
	if not folder then
		return false, nil
	end
	local model = folder:FindFirstChild("Maze")
	if not model or not model:IsA("Model") then
		return false, nil
	end
	return model:FindFirstChildWhichIsA("BasePart", true) ~= nil, folder
end
