state.hyperFreshSoul = function()
	-- hyperFindSoul already rejects anything parented under a HyperSansta/HATE model.
	-- Never fall back to a raw workspace scan here: a dead boss keeps "heart" parts
	-- inside its body, and treating one as a fresh soul ends the run during a phase cutscene.
	local soul = state.hyperFindSoul and state.hyperFindSoul()
	if not soul then
		return nil
	end
	if state.hyperSoulIgnore and state.hyperSoulIgnore[soul] then
		return nil
	end
	-- Explicit second guard: a soul must sit outside every boss body. The game
	-- keeps "heart" meshes inside HyperSansta/HATE even after health reaches 0.
	local node = soul
	while node and node ~= workspace do
		local n = string.lower(tostring(node.Name or ""))
		if string.find(n, "sansta", 1, true) or string.find(n, "hate", 1, true) then
			return nil
		end
		node = node.Parent
	end
	return soul
end
