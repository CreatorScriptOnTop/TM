								end
								task.wait(1.0)
							end
							if obj.Parent then
								mark("code " .. name .. " still present after " .. fires .. " fire(s), not counted")
								break
							end
							handled[name] = true
							handleCount += 1
							local here = TMS_EVENT_KEEP.eventRoot()
							local gap = (here and tgt) and (here.Position - tgt).Magnitude or -1
							mark("code " .. name .. " collected " .. handleCount .. "/" .. #codeParts
								.. " after " .. fires .. " fire(s)"
								.. " target=" .. (tgt and string.format("%.0f,%.0f,%.0f",
									tgt.X, tgt.Y, tgt.Z) or "?")
								.. " player=" .. (here and string.format("%.0f,%.0f,%.0f",
									here.Position.X, here.Position.Y, here.Position.Z) or "?")
								.. " gap=" .. string.format("%.1f", gap))
							break
						end
					end
				end
			end
			task.wait(TMS_EVENT_KEEP.EVENT_POLL)
			waited += (tick() - passStart)
		end
		state.trackCodeTools(false)
		mark("code tools TMS_TOOL_KEEP.tracked=" .. #state.codeTools)
		if handleCount >= #codeParts then
			allDone = true
		end
		if allDone then
			local slotsDone = placeCodeSlotLetters()
			note("Codeparts", slotsDone and "done" or "slots-incomplete")
		else
			note("Codeparts", "collected " .. handleCount .. "/" .. #codeParts)
		end
		if state.chest.autoDebugEvent then
			fiveSlot = workspace:FindFirstChild("5 Slot Generator")
			if fiveSlot then
				TMS_EVENT_KEEP.eventTpTo(fiveSlot)
			end
		end
	end
	end
	setDebugStage("")
	if state.chest.autoDebugEvent then
		state.chest.autoDebugEvent = false
		state.setToggle("debugEvent", false)
	end
	local failed = 0
	for _, s in ipairs(steps) do
		if string.find(s, "timeout", 1, true) or string.find(s, "missing", 1, true) then
			failed += 1
		end
	end
	notify(
		"Auto Debug World",
		failed == 0 and table.concat(steps, "\n") or (table.concat(steps, "\n") .. "\n" .. failed .. " step(s) stalled"),
		failed == 0 and "check" or "alert-triangle"
	)
end
state.detectDebugStage = function()
	local result = ""
	local text = ""
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local main = pg and pg:FindFirstChild("Stuff")
	main = main and main:FindFirstChild("Main")
	local label = main and main:FindFirstChild("Stuffs")
	pcall(function()
		text = tostring(label and label.Text or "")
	end)
	local hasTouch = false
	for _, n in ipairs({ "Touchevent", "Touchevent2", "Touchevent3" }) do
		if workspace:FindFirstChild(n) then
			hasTouch = true
			break
		end
	end
	if hasTouch then
		result = "touchevents"
	else
		local gens, done = 0, 0
		for _, n in ipairs({ "Gen 1", "Gen 2", "Gen 3" }) do
			local gen = workspace:FindFirstChild(n)
			if gen then
				gens += 1
				local lb = gen:FindFirstChild("Electrical Box With Lever")
				local m = lb and lb:FindFirstChild("Main")
				local flag = m and m:FindFirstChild("Generatordone")
				if flag and flag.Value == true then
					done += 1
				end
			end
		end
		if gens > 0 and done < gens then
			result = "generators"
		else
			local hasCode = workspace:FindFirstChild("5 Slot Generator") ~= nil
			if not hasCode then
				for _, n in ipairs({ "Codepart1", "Codepart2", "Codepart3", "Codepart4", "Codepart5" }) do
					if workspace:FindFirstChild(n) then
						hasCode = true
						break
					end
				end
			end
			if hasCode then
				result = "codeparts"
			end
		end
	end
	if result == "" then
		local low = string.lower(text)
		if string.find(low, "touch", 1, true) then
			result = "touchevents"
		elseif string.find(low, "generator", 1, true) then
			result = "generators"
		elseif string.find(low, "code", 1, true) or string.find(low, "slot", 1, true) then
			result = "codeparts"
		end
	end
	state.chest.debugObjective = text
	state.chest.detectedDebugStage = result
	return result
end
local function runDebugEvent(startStage)
	if state.chest.eventRunning then
		return
	end
	local detected = state.detectDebugStage()
	local function rank(stage)
		if stage == "touchevents" then
			return 1
		elseif stage == "generators" then
			return 2
		elseif stage == "codeparts" then
			return 3
		end
		return 0
	end
	if startStage == nil then
		startStage = detected or "touchevents"
	elseif detected ~= "" and rank(detected) > rank(startStage) then
		startStage = detected
	elseif detected == "" then
		startStage = ""
	end
	state.chest.debugStartStage = startStage
	state.chest.eventRunning = true
	local ok, err = xpcall(function()
		return runDebugEventBody(startStage)
	end, function(e)
		return tostring(e)
	end)
	state.chest.eventRunning = false
	state.chest.lastChainOk = ok
	state.chest.lastChainErr = err
	if not ok then
		setDebugStage("")
		state.chest.autoDebugEvent = false
		pcall(state.setToggle, "debugEvent", false)
		notify("Auto Debug World", "Chain crashed: " .. tostring(err), "alert-triangle")
		return
	end
	setDebugStage("")
	if state.chest.autoDebugEvent then
		state.chest.autoDebugEvent = false
		pcall(state.setToggle, "debugEvent", false)
	end
end
