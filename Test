						or m:FindFirstChild("Head")
					if r and r:IsA("BasePart") then
						local far = true
						if awayFrom then
							far = (r.Position - awayFrom).Magnitude > 1000
						end
						if far then
							local d = (r.Position - myRoot.Position).Magnitude
							if d < bestDist then
								best = hum
								bestDist = d
							end
						end
					end
				end
			end
			return best
		end
		while AUTO_TIANTUI and state.chest.autoTiantui do
			cycles += 1
			state.chest.tiantuiCycles = cycles
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local model = rulerModel()
			if not root or not model then
				notify("TianTui", "The Ruler is not here, waiting.", "clock")
				local waited = 0
				while waited < 20 and AUTO_TIANTUI and state.chest.autoTiantui do
					task.wait(0.5)
					waited += 0.5
					model = rulerModel()
					root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				end
				if not model or not root then
					failures += 1
					notify(
						"TianTui",
						string.format("Cycle %d could not find the Ruler (fail %d/%d).", cycles, failures, MAX_FAILURES),
						failures >= MAX_FAILURES and "alert-triangle" or "clock"
					)
					if failures >= MAX_FAILURES then
						break
					end
					continue
				end
			end
			local coins = trollCoins()
			if coins < 500000 then
				notify(
					"TianTui",
					string.format("Need 500k TrollCoins, you have %s. Stopping.", tostring(coins)),
					"alert-triangle"
				)
				state.chest.autoTiantui = false
				AUTO_TIANTUI = false
				CYCLE_IN_PROGRESS = false
				break
			end
			notify("TianTui", string.format("Cycle %d, going to the Ruler...", cycles), "search")
			local mr = model:FindFirstChild("HumanoidRootPart")
				or model:FindFirstChild("Head")
				or model:FindFirstChildWhichIsA("BasePart")
			if mr and root then
				pcall(function()
					root.CFrame = mr.CFrame * CFrame.new(0, 3, 4)
				end)
			end
			local rulerPos = mr and mr.Position or nil
			local prompt = rulerPrompt()
			if not prompt then
				notify("TianTui", "The Ruler has no prompt, stopping.", "alert-triangle")
				state.chest.autoTiantui = false
				AUTO_TIANTUI = false
				CYCLE_IN_PROGRESS = false
				break
			end
			pcall(function()
				prompt.HoldDuration = 0
				prompt.MaxActivationDistance = 60
			end)
			local knownBefore = snapshotNpcs()
			local fired = false
			local chargeWorked = false
			for attempt = 1, 2 do
				if not AUTO_TIANTUI or not state.chest.autoTiantui then break end
				if prompt.Parent then
					local ok = pcall(function()
						TMS.firePrompt(prompt)
					end)
					if ok then
						fired = true
					end
				end
				task.wait(1.2)
				local after = trollCoins()
				if after < coins then
					chargeWorked = true
					break
				elseif attempt == 1 then
					notify("TianTui", "Charge didn't register, retrying...", "clock")
				else
					notify("TianTui", string.format("No charge went through (%s TrollCoins left).", tostring(after)), "alert-triangle")
				end
			end
			if not fired then
				notify("TianTui", "Could not fire the Ruler's prompt.", "alert-triangle")
			end
			local boss = nil
			local waited = 0
			while waited < 25 and AUTO_TIANTUI and state.chest.autoTiantui do
				task.wait(0.25)
				waited += 0.25
				for hum in pairs(npcHumanoids) do
					if not knownBefore[hum] and hum.Parent and hum.Health > 0 and not isPlayerHumanoid(hum) then
						boss = hum
						break
					end
				end
				if boss then
					break
				end
			end
			if not boss then
				boss = nearestNpc(400, rulerPos)
			end
			if not boss then
				notify(
					"TianTui",
					string.format("No boss after the teleport (fail %d/%d).", failures + 1, MAX_FAILURES),
					"alert-triangle"
				)
				failures += 1
				if failures >= MAX_FAILURES then
					notify("TianTui", "Stopping after 3 failures.", "alert-triangle")
					break
				end
				continue
			end
			failures = 0
			local bossName = boss.Parent and boss.Parent.Name or "?"
			state.chest.tiantuiBossName = bossName
			notify("TianTui", "Boss found: " .. bossName .. ". Insta kill on.", "check")
			state.driveInstaKill(true)
			local killed = false
			local passes = 0
			while AUTO_TIANTUI and state.chest.autoTiantui do
				passes += 1
				task.wait(0.1)
				if passes > 900 then
					notify("TianTui", "Still alive after 90s, turning insta kill off.", "alert-triangle")
					break
				end
				if boss.Parent == nil or boss.Health <= 0 then
					killed = true
					break
				end
			end
			state.driveInstaKill(false)
			task.wait(2)
			if killed then
				notify("TianTui", string.format("Cycle %d killed %s.", cycles, bossName), "check")
				if stopOnKill and not autoFarm then
					state.chest.autoTiantui = false
					AUTO_TIANTUI = false
					break
				end
			else
				notify("TianTui", string.format("Cycle %d over.", cycles), "clock")
			end
			if maxCycles > 0 and cycles >= maxCycles then
				notify("TianTui", string.format("Reached max cycles (%d). Stopping.", maxCycles), "clock")
				state.chest.autoTiantui = false
				AUTO_TIANTUI = false
				CYCLE_IN_PROGRESS = false
				break
			end
			task.wait(waitAfterKill)
		end
		AUTO_TIANTUI = false
		CYCLE_IN_PROGRESS = false
		state.driveInstaKill(false)
		state.chest.tiantuiRunning = false
		notify("TianTui", "Farm stopped.", "check")
	end)
end
local function enforceAllPrompts()
	local n = 0
	for prompt in pairs(promptRegistry) do
		enforcePrompt(prompt)
		n = n + 1
	end
