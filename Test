state.uiToggles.whatOnceWas = SectionWhatOnce:Toggle({
	Title = "TP to WhatOnceWas (if it spawns)",
	Value = state.localMods.whatOnceWas,
	Flag = "whatOnceWas",
	Callback = function(v)
		state.localMods.whatOnceWas = v
		if not v then
			whatOnceRunning = false
			return
		end
		if whatOnceRunning then
			return
		end
		whatOnceRunning = true
		task.spawn(function()
			local waited = 0
			while state.localMods.whatOnceWas do
				local obj = workspace:FindFirstChild("WhatOnceWas")
				local root = LocalPlayer.Character
					and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if obj and root then
					local part = obj:IsA("BasePart") and obj
						or obj:FindFirstChildWhichIsA("BasePart", true)
						or obj
					if typeof(part) == "Instance" and part:IsA("BasePart") then
						if TMS_TOOL_KEEP.isHardBlocked(part) then
							state.localMods.whatOnceWas = false
							state.setToggle("whatOnceWas", false)
							notify(
								"WhatOnceWas",
								"It spawned outside the safe area, so I stopped. That spot is an instant ban.",
								"alert-triangle"
							)
							break
						end
						pcall(function()
							root.CFrame = part.CFrame + Vector3.new(0, 3, 0)
						end)
					end
					waited = 0
				else
					waited = waited + 0.5
					if waited == 60 then
						notify("WhatOnceWas", "Still waiting for it to spawn.", "clock")
					end
				end
				task.wait(0.5)
			end
			whatOnceRunning = false
		end)
	end,
})
