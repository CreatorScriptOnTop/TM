	end
	if not bossRoot then
		notify("Hyper Sansta", "Hyper boss not found after waiting.", "alert-triangle")
		local autoToggle = state.uiToggles and state.uiToggles.hyperAuto
		if autoToggle then
			pcall(function()
				autoToggle:Set(false)
			end)
		end
		state.hyperAutoRunning = false
		return
	end
	notify("Hyper Sansta", "Auto HyperBoss started.", "skull")
	state.hyperSoulIgnore = {}
	for _, o in ipairs(workspace:GetDescendants()) do
		if o:IsA("BasePart") or o:IsA("Model") or o:IsA("ProximityPrompt") then
			local n = string.lower(o.Name or "")
			if (string.find(n, "hyper", 1, true) and (string.find(n, "soul", 1, true) or string.find(n, "heart", 1, true)))
				or n == "soul"
				or n == "heart"
				or string.find(n, "hypersoul", 1, true)
				or string.find(n, "hyperheart", 1, true) then
				state.hyperSoulIgnore[o] = true
			end
		end
	end
	state.hyperLastKillPos = nil
	state.hyperLastKillRoot = nil
	state.hyperLastKillAt = nil
	state.hyperEnsureBaseplate()
	-- 1. TP to the boss front, then move forward so the opening cutscene triggers.
	state.hyperGoDown()
	state.hyperNudgeToBoss(token)
	state.hyperWaitCutsceneStart(token, 12)
	state.hyperWaitCutsceneEnd(token, 90)
	if not state.hyperAutoActive(token) then
		return
	end
	-- 2. Hold on the safe baseplate until the boss is dead.
	task.spawn(function()
		state.hyperHoldSafe(token)
	end)
	task.wait(0.5)
	if not state.hyperAutoActive(token) then
		return
	end
	-- 3. Keep killing until the boss is dead, then teleport to the boss or its soul.
	local kills = 0
	local function freshSoul()
		return state.hyperFreshSoul and state.hyperFreshSoul() or nil
	end
	local function endReady()
		if kills < 1 then
			return false
		end
		-- A phase death leaves the old boss/root alive while its cutscene plays.
		-- Never finish during that window, even if health is already zero.
		if state.hyperDialogueActive and state.hyperDialogueActive() then
			return false
		end
		if state.hyperBossPending and state.hyperBossPending() then
			return false
		end
		if kills >= 2 and freshSoul() then
			return true
		end
		if state.hyperQuickKillTarget and state.hyperQuickKillTarget() then
			return false
		end
		if kills >= 2 and state.hyperDeadBoss and state.hyperDeadBoss() then
			return true
		end
		if state.hyperLastKillAt and os.clock() - state.hyperLastKillAt > 30 then
			return true
		end
		return false
	end
	local function finish()
		local waitSeconds = tonumber(state.hyperSoulWaitSeconds) or 6
		local waited = 0
		while state.hyperAutoActive(token) and waited < waitSeconds do
			task.wait(0.5)
			waited += 0.5
		end
		-- Extra safety: the soul wait can straddle the final phase cutscene.
		-- Hold position until dialogue/root cleanup finishes instead of teleporting
		-- into a boss that is about to change phase.
		local guard = 0
		while state.hyperAutoActive(token) and guard < 60 do
			local dialogue = state.hyperDialogueActive and state.hyperDialogueActive() or false
			local pending = state.hyperBossPending and state.hyperBossPending() or false
			if not dialogue and not pending then
				break
			end
			task.wait(0.5)
			guard += 0.5
		end
		if state.hyperAutoActive(token)
			and ((state.hyperDialogueActive and state.hyperDialogueActive() )
				or (state.hyperBossPending and state.hyperBossPending())) then
			local autoToggle = state.uiToggles and state.uiToggles.hyperAuto
			if autoToggle then
				pcall(function()
					autoToggle:Set(false)
				end)
			end
			state.hyperReleaseSafe(token)
			state.hyperRemoveBaseplate()
			state.hyperAutoRunning = false
			notify("Hyper Sansta", "Phase transition did not finish. Stopped without teleporting.", "alert-triangle")
			return
		end
		state.hyperReleaseSafe(token)
		local target = freshSoul()
		if not target then
			local dead = state.hyperDeadBoss and state.hyperDeadBoss()
			target = dead and dead:FindFirstChild("HumanoidRootPart") or nil
			if not target then
				target = state.hyperLastKillRoot
			end
		end
		local root = state.hyperRoot()
		if root then
			pcall(function()
				if target and target.Parent and target:IsA("BasePart") then
					root.CFrame = target.CFrame + Vector3.new(0, 5, 0)
				elseif state.hyperLastKillPos then
					root.CFrame = CFrame.new(state.hyperLastKillPos + Vector3.new(0, 5, 0))
				end
			end)
		end
		task.wait(0.2)
		state.hyperRemoveBaseplate()
		local autoToggle = state.uiToggles and state.uiToggles.hyperAuto
		if autoToggle then
			pcall(function()
				autoToggle:Set(false)
			end)
		end
		state.hyperAutoRunning = false
		notify("Hyper Sansta", "Boss dead. Teleported to boss/soul. All steps stopped.", "check")
	end
	while state.hyperAutoActive(token) do
		if endReady() then
			break
		end
		local killed = state.hyperKillOnce(token)
		if not state.hyperAutoActive(token) then
			break
		end
		if killed then
			kills += 1
			state.hyperWaitCutsceneStart(token, 12)
			state.hyperWaitCutsceneEnd(token, 90)
			if not state.hyperAutoActive(token) then
				break
			end
		else
			task.wait(1)
		end
		if endReady() then
			break
		end
		task.wait(1)
	end
	finish()
end
