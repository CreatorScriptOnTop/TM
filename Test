		local direct = inst:FindFirstChildOfClass("ProximityPrompt")
		if direct then
			return direct
		end
		return inst:FindFirstChildWhichIsA("ProximityPrompt", true)
	end
	local function isTakePrompt(prompt)
		local text = string.lower(tostring(prompt.ObjectText) .. " " .. tostring(prompt.ActionText))
		if string.find(text, "tape", 1, true) or string.find(text, "note", 1, true) then
			return false
		end
		return string.find(text, "??", 1, true) ~= nil
	end
