local function initialNpcScan()
	local MAX_DEPTH = 20
	local MAX_VISITS = 120000
	local stack = {}
	for _, child in ipairs(workspace:GetChildren()) do
		stack[#stack + 1] = { inst = child, depth = 1 }
	end
	local visits = 0
	while #stack > 0 and visits < MAX_VISITS do
		local node = table.remove(stack)
		local inst = node.inst
		visits = visits + 1
		if inst:IsA("Humanoid") then
			registerHumanoid(inst)
		end
		if node.depth < MAX_DEPTH then
			local ok, kids = pcall(function()
				return inst:GetChildren()
			end)
			if ok then
				for _, kid in ipairs(kids) do
					stack[#stack + 1] = { inst = kid, depth = node.depth + 1 }
				end
			end
		end
		if visits % 5000 == 0 then
			task.wait()
		end
	end
	state.debug.scanDone = true
	state.debug.scanVisits = visits
	state.debug.scanMs = math.floor((os.clock() - state.debug.scanStart) * 1000)
end
