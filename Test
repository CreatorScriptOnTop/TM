	local cave = map and map:FindFirstChild("Cave")
	if cave then
		scan(cave)
	end
	local chests = workspace:FindFirstChild("ChestFolderThing")
	if chests then
		local asc = chests:FindFirstChild("AscRelic_Spawn")
		if asc then
			collect(asc, true)
		end
		for _, child in ipairs(chests:GetChildren()) do
			collect(child)
		end
	end
	return out
