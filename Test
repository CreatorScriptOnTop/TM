			local placed = 0
			-- The game snaps a re-parented codepart tool back to Storedstuff almost
			-- immediately, so keep re-equipping it while the slot prompt is used.
			local function holdCodeTool(t, seconds)
				local char = LocalPlayer.Character
				if not t or not char then
