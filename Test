		local function armDetect(untilAt, bossNow)
			detectUntil = untilAt
			detectFired = false
			detectLateAt = 0
			detectSkip = {}
			parryAt = 0
			local humA = bossNow and bossNow:FindFirstChildOfClass("Humanoid")
			local animA = humA and humA:FindFirstChildOfClass("Animator")
			if animA then
				for _, tr in ipairs(animA:GetPlayingAnimationTracks()) do
					local an = tr.Animation
					local idA = an and tostring(an.AnimationId):match("(%d+)$")
					if idA and strikeFrames[idA] and tr.TimePosition >= strikeFrames[idA] - 0.05 then
						if tr.TimePosition <= strikeFrames[idA] + 0.55 then
							pressE()
							queueMap(idA, tr.TimePosition, bossNow)
							detectFired = true
							detectUntil = 0
							local late = lateRefire[idA] or 0
							if late > 0 then detectLateAt = os.clock() + late end
							print("[TMS] DETECT_IMMEDIATE id=" .. tostring(idA) ..
								" tp=" .. string.format("%.2f", tr.TimePosition))
						else
							detectSkip[tr] = true
						end
					end
				end
			end
		end
		local parryWordDelays = {
			["Die."] = 0.85,
			["Fall."] = 1.05,
			["Heads up."] = 1.30,
			["Disappear."] = 0.55,
			["It's not too late to give up."] = 1.80,
			["Let's see how you fare against this."] = 1.05,
			["Such a little pest."] = 1.05,
			["How interesting."] = 1.05,
			["Your mortality led you here."] = 1.05,
			["I have an offer."] = 1.05,
		}
		while state.ascend.auto and task.wait(0.02) do
			local now = os.clock()
			local bossObj = workspace:FindFirstChild("Bosses") and workspace.Bosses:FindFirstChild("Ascend")
			local bossAI = bossObj and bossObj:FindFirstChild("AI")
			local bossMisc = bossAI and bossAI:FindFirstChild("Stuff") and bossAI.Stuff:FindFirstChild("Misc")
			local phaseFlag = bossMisc and bossMisc:FindFirstChild("Phase2")
			local phase1 = not phaseFlag or tostring(phaseFlag.Value) ~= "true"
			local ok, txt = pcall(dtext)
			if ok and txt ~= prevTxt then
				local word = txt:gsub("^%.+", "")
				local wTrim = word:gsub("%s+$", "")
				local isCease = (wTrim == "Cease" or wTrim == "Cease.")
				local isPerish = (wTrim == "Perish" or wTrim == "Perish.")
				if isCease and phase1 and ceaseNoclipUntil == 0 then
					ceaseNoclipPrev = state.localMods.noclip and true or false
					applyNoclip(true)
					ceaseNoclipUntil = now + 6
				end
				if (isCease or isPerish) and not state.ascend.dodgeWordActive then
					state.ascend.dodgeWordActive = true
					if state.ascend.dodgeEnabled then
						local ch = plr.Character
						local root = ch and ch:FindFirstChild("HumanoidRootPart")
						local br = bossRoot()
						if root and br then
							state.ascend.origin = root.CFrame
							local hum = ch and ch:FindFirstChildOfClass("Humanoid")
							avoidStartHP = hum and math.floor(hum.Health) or -1
							root.CFrame = CFrame.new(br.Position + Vector3.new(0, 100, 0))
							avoidUntil = now + (isCease and 6 or 3)
							state.ascend.avoids += 1
							state.ascend.lastWord = txt
						end
					end
				elseif not (isCease or isPerish) then
					state.ascend.dodgeWordActive = false
				end
				if phase1 then
					local prevEnd = prevTxt:sub(-1)
					local nowEnd = txt:sub(-1)
					if (nowEnd == "." or nowEnd == "?") and not (prevEnd == "." or prevEnd == "?")
						and word ~= "" then
						state.ascend.lastWord = word
						if word == "Disappear." then
							-- Updated Disappear: the full word is the primary parry timer.
							-- The 90516863757785 animation-stop watcher can only make it earlier.
							disappearAt = now
							disappearParryAt = now + 2.25
							print("[TMS] DISAPPEAR_PRIMARY in=2.25")
							if detectUntil == 0 and detectLateAt == 0 then armDetect(now + 6.0, bossObj) end
						else
							local delay = parryWordDelays[word]
							if delay then
								local extra = 0
								local ch = plr.Character
								local root = ch and ch:FindFirstChild("HumanoidRootPart")
								local br = bossRoot()
								if root and br then
									local dx = root.Position.X - br.Position.X
									local dz = root.Position.Z - br.Position.Z
									local flat = math.sqrt(dx * dx + dz * dz)
									if flat > 30 then
										extra = math.min((flat - 30) / 75, 1.0)
									end
								end
								parryAt = now + delay + extra
								if detectUntil == 0 and detectLateAt == 0 then armDetect(now + 6.0, bossObj) end
							end
						end
					end
				else
					if word == "Disappear." then
						disappearAt = now
						disappearParryAt = now + 2.25
						print("[TMS] DISAPPEAR_PRIMARY in=2.25")
						if detectUntil == 0 and detectLateAt == 0 then
							armDetect(now + 6.0, bossObj)
						end
					end
				end
				prevTxt = txt
			end
			-- Live samples: the hit lands ~2.2-3.0s after the full word. The word
			-- timer above is primary; the 90516863757785 loop is only an earlier
			-- backup and must never replace a later primary timer.
			local foundDisappearAnim = false
			local humD = bossObj and bossObj:FindFirstChildOfClass("Humanoid")
			local animD = humD and humD:FindFirstChildOfClass("Animator")
			if animD then
				for _, tr in ipairs(animD:GetPlayingAnimationTracks()) do
					local anD = tr.Animation
					local idD = anD and tostring(anD.AnimationId):match("(%d+)$")
					if idD == "90516863757785" then
						foundDisappearAnim = true
						local tpD = tr.TimePosition or 0
						local backupAt = now + 1.5
						if disappearAnimTp and disappearAnimTp > 2.5 and tpD < 0.3
							and disappearAt > 0 and now - disappearAt < 5
							and now - lastDisappearStop > 2
							and (disappearParryAt == 0 or backupAt < disappearParryAt) then
							lastDisappearStop = now
							disappearParryAt = backupAt
							print("[TMS] DISAPPEAR_STOP tp=" .. string.format("%.2f", disappearAnimTp) ..
								" parryIn=1.50 backup")
						end
						disappearAnimTp = tpD
						break
					end
				end
			end
			if not foundDisappearAnim then
				disappearAnimTp = nil
			end
			if state.ascend.parryEnabled and detectLateAt == 0 then
				local humR = bossObj and bossObj:FindFirstChildOfClass("Humanoid")
				local animR = humR and humR:FindFirstChildOfClass("Animator")
				if animR then
					local wtR = txt:gsub("%s+$", "")
					local unsafeR = (wtR == "Cease" or wtR == "Cease." or wtR == "Perish" or wtR == "Perish.")
					if not unsafeR then
						for _, tr in ipairs(animR:GetPlayingAnimationTracks()) do
							local anR = tr.Animation
							local idR = anR and tostring(anR.AnimationId):match("(%d+)$")
							if idR and strikeFrames[idR] and tr.TimePosition < 0.60
								and now - (lastArmAt[idR] or 0) > 2.0 then
								lastArmAt[idR] = now
								armDetect(now + 6.0, bossObj)
								print("[TMS] ARM_ANIM id=" .. tostring(idR) ..
									" tp=" .. string.format("%.2f", tr.TimePosition))
								break
							end
						end
					end
				end
			end
			if not phase1 then
				local inAb = bossInAbility()
				if inAb and not prevInAb then
					local hum2 = bossObj and bossObj:FindFirstChildOfClass("Humanoid")
					local animator = hum2 and hum2:FindFirstChildOfClass("Animator")
					local ids = {}
					if animator then
						for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
							local anim = tr.Animation
							local id = anim and tostring(anim.AnimationId):match("(%d+)$")
							if id then ids[id] = true end
						end
					end
					local mustDodge = ids["116923940814638"] or ids["78750223444331"]
					if mustDodge and state.ascend.dodgeEnabled then
						local ch = plr.Character
						local root = ch and ch:FindFirstChild("HumanoidRootPart")
						local br = bossRoot()
						if root and br then
							state.ascend.origin = root.CFrame
							local hum = ch and ch:FindFirstChildOfClass("Humanoid")
							avoidStartHP = hum and math.floor(hum.Health) or -1
							root.CFrame = CFrame.new(br.Position + Vector3.new(0, 100, 0))
							avoidUntil = now + (ids["78750223444331"] and 5.2 or 3.6)
							state.ascend.avoids += 1
							parryAt = 0
						end
					else
						local delay = 0.95
						if ids["116923940814638"] then
							delay = 1.50
						elseif ids["133214142012321"] then
							delay = 1.48
						elseif ids["105720022314807"] then
							delay = 0.90
						elseif ids["137513620197797"] then
							delay = 0.80
						elseif ids["78750223444331"] then
							delay = 3.30
						elseif ids["74595066178838"] or ids["90516863757785"] then
							delay = 2.60
						end
						local extra = 0
						local ch = plr.Character
						local root = ch and ch:FindFirstChild("HumanoidRootPart")
						local br = bossRoot()
						if root and br then
							local dx = root.Position.X - br.Position.X
							local dz = root.Position.Z - br.Position.Z
							local flat = math.sqrt(dx * dx + dz * dz)
							if flat > 30 then extra = math.min((flat - 30) / 40, 1.2) end
						end
						parryAt = now + delay + extra
						if detectUntil == 0 and detectLateAt == 0 then armDetect(now + 6.0, bossObj) end
					end
				end
				prevInAb = inAb
			else
				prevInAb = false
			end
			if state.ascend.parryEnabled then
				local rootM = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				local brM = bossObj and bossObj:FindFirstChild("HumanoidRootPart")
				local flatM = math.huge
				if rootM and brM then
					local dxM = rootM.Position.X - brM.Position.X
					local dzM = rootM.Position.Z - brM.Position.Z
					flatM = math.sqrt(dxM * dxM + dzM * dzM)
				end
				local m1InRange = flatM <= 15
				local humM = bossObj and bossObj:FindFirstChildOfClass("Humanoid")
				local animM = humM and humM:FindFirstChildOfClass("Animator")
				local trM = nil
				if animM then
					for _, tr in ipairs(animM:GetPlayingAnimationTracks()) do
						local anM = tr.Animation
						local idM = anM and tostring(anM.AnimationId):match("(%d+)$")
						if idM == "140194040010339" then trM = tr break end
					end
				end
				local meleeNow = trM ~= nil
				local m1Allowed = m1InRange
				if meleeNow and not prevMelee and m1StrikeAt == 0 and now - m1LastAt > 0.70 and m1Allowed then
					local lead = trM and (0.20 - trM.TimePosition) or 0.18
					if lead < 0.05 then lead = 0.05 end
					if lead > 0.30 then lead = 0.30 end
					m1StrikeAt = now + lead
				end
				prevMelee = meleeNow
				if m1StrikeAt > 0 and now >= m1StrikeAt then
					m1StrikeAt = 0
					if m1InRange then
						m1LastAt = now
						pressE()
						state.ascend.m1Parries += 1
						print("[TMS] M1_PARRY d=" .. string.format("%.0f", flatM))
					end
				end
			else
				prevMelee = false
				m1StrikeAt = 0
			end
			if state.ascend.parryEnabled and now < detectUntil and not detectFired then
				local humD = bossObj and bossObj:FindFirstChildOfClass("Humanoid")
				local animD = humD and humD:FindFirstChildOfClass("Animator")
				if animD then
					for _, tr in ipairs(animD:GetPlayingAnimationTracks()) do
						if not (detectSkip and detectSkip[tr]) then
							local an = tr.Animation
							local id = an and tostring(an.AnimationId):match("(%d+)$")
							local target = id and strikeFrames[id]
							if target and tr.TimePosition >= target then
								pressE()
								queueMap(id, tr.TimePosition, bossObj)
								detectFired = true
								detectUntil = 0
								parryAt = 0
								local late = id and lateRefire[id] or 0
								if late > 0 then detectLateAt = now + late end
								print("[TMS] DETECT_FIRE id=" .. tostring(id) ..
									" tp=" .. string.format("%.2f", tr.TimePosition) ..
									" len=" .. string.format("%.2f", tr.Length))
								break
							end
						end
					end
				end
			end
			if state.ascend.parryEnabled and #mapQueue > 0 then
				local remain = {}
				for _, q in ipairs(mapQueue) do
					if now >= q.at and not hitMapFired[q.key] then
						hitMapFired[q.key] = true
						pressE()
						print("[TMS] HITMAP_FIRE key=" .. tostring(q.key))
					elseif now < q.at then
						remain[#remain + 1] = q
					end
				end
				mapQueue = remain
			end
			if state.ascend.parryEnabled and detectLateAt > 0 and now >= detectLateAt then
				pressE()
				detectLateAt = 0
				print("[TMS] DETECT_REFIRE n=" .. tostring(state.ascend.parries))
			end
			if not state.ascend.parryEnabled and disappearParryAt > 0 then
				disappearParryAt = 0
				disappearAt = 0
			end
			if state.ascend.parryEnabled and disappearParryAt > 0 and now >= disappearParryAt then
				disappearParryAt = 0
				disappearAt = 0
				pressE()
				print("[TMS] DISAPPEAR_PARRY n=" .. tostring(state.ascend.parries))
			end
			if state.ascend.parryEnabled and parryAt > 0 and now >= parryAt
				and not (now < detectUntil) then
				pressE()
				parryAt = 0
				detectUntil = 0
				detectFired = true
				if not phase1 then
					print("[TMS] P2_PARRY_FIRE n=" .. tostring(state.ascend.parries))
				end
			end
			if ceaseNoclipUntil > 0 and now >= ceaseNoclipUntil then
				if state.localMods.noclip then applyNoclip(ceaseNoclipPrev) end
				ceaseNoclipUntil = 0
			end
			if now < avoidUntil then
				local ch = plr.Character
				local root = ch and ch:FindFirstChild("HumanoidRootPart")
				local br = bossRoot()
				if root and br then
					local ang = (now * 1.5) % (math.pi * 2)
					root.CFrame = CFrame.new(br.Position + Vector3.new(math.cos(ang) * 15, 100, math.sin(ang) * 15))
				end
			elseif state.ascend.origin then
				local ch = plr.Character
				local root = ch and ch:FindFirstChild("HumanoidRootPart")
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				if root then root.CFrame = state.ascend.origin end
				if hum and avoidStartHP > 0 and hum.Health >= avoidStartHP then
					state.ascend.dodged += 1
				end
				state.ascend.origin = nil
			end
			-- Insta Kill is manual only: use the button or G.__TMS_ASCEND.instaOnce().
		end
		if state.ascend.origin then
			local ch = plr.Character
			local root = ch and ch:FindFirstChild("HumanoidRootPart")
			if root then root.CFrame = state.ascend.origin end
			state.ascend.origin = nil
		end
		if ceaseNoclipUntil > 0 then
			if state.localMods.noclip then applyNoclip(ceaseNoclipPrev) end
			ceaseNoclipUntil = 0
		end
		state.ascend.running = false
	end)
end
