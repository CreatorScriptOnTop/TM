	local function getCharacterRoot()
		local char = plr.Character or plr.CharacterAdded:Wait()
		return char:FindFirstChild("HumanoidRootPart")
	end
	local function teleportToPrompt(prompt)
		local root = getCharacterRoot()
		if not root or not prompt then return end
		if prompt.Parent and prompt.Parent:IsA("BasePart") then
			root.CFrame = prompt.Parent.CFrame + Vector3.new(0, 3, 0)
		else
			root.CFrame = CFrame.new(prompt.WorldPosition) + Vector3.new(0, 3, 0)
		end
		pcall(function()
			game:GetService("ReplicatedStorage"):WaitForChild("BlockEvent"):FireServer(true)
			task.wait(0.1)
			game:GetService("ReplicatedStorage"):WaitForChild("BlockEvent"):FireServer(false)
		end)
	end
	local function isRealMirror(mirror)
		for _, d in ipairs(mirror:GetDescendants()) do
			if d:IsA("PointLight") and (d.Name == "OrangeLight" or d.Name == "BlueLight" or d.Name == "YellowLight") then
				return true
			end
		end
		return false
	end
	local function setupPrompt(prompt)
		if prompt and prompt:IsA("ProximityPrompt") then
			task.wait(0.1)
			teleportToPrompt(prompt)
		end
	end
	local function handleMirror(mirror)
		if not mirror then return end
		if not isRealMirror(mirror) then return end
		local existingPrompt = mirror:FindFirstChildOfClass("ProximityPrompt", true)
		if existingPrompt then
			setupPrompt(existingPrompt)
		end
		mirror.DescendantAdded:Connect(function(descendant)
			if descendant:IsA("ProximityPrompt") then
				setupPrompt(descendant)
			end
		end)
	end
	local existing = WS:FindFirstChild("Mirror")
	if existing and isRealMirror(existing) then
		handleMirror(existing)
	end
	WS.ChildAdded:Connect(function(child)
		if child.Name == "Mirror" and isRealMirror(child) then
			handleMirror(child)
		end
	end)
end)
