local function runGenerator(genName)
	local gen = workspace:FindFirstChild(genName)
	if not gen then
		return "missing"
	end
	local leverBox = gen:IsA("Model") and gen:FindFirstChild("Electrical Box With Lever") or nil
	local main = leverBox and leverBox:FindFirstChild("Main") or nil
	local genPart = TMS_EVENT_KEEP.eventPart(main or gen)
	if not state.holdGenerator(genPart) then
		TMS_EVENT_KEEP.eventTpTo(main or gen)
	end
	state.chest.genPromptLog = ""
	state.chest.genSolvedClose = nil
	state.chest.genZeroWaitStreak = 0
	local function finish(result)
		state.releaseGenHold()
		return result
	end
	local function puzzleGuiOpen()
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		return pg and pg:FindFirstChild("Generator") ~= nil or false
	end
	local settle = 0
	while settle < 2.5 and main do
		if not TMS_EVENT_KEEP.eventWaitAlive() or TMS_EVENT_KEEP.eventShouldAbort() then
			return finish("aborted")
		end
		local root = TMS_EVENT_KEEP.eventRoot()
		local part = main:FindFirstChildWhichIsA("BasePart")
		if root and part and (root.Position - part.Position).Magnitude < 8 then
			break
		end
		task.wait(0.1)
		settle += 0.1
	end
	-- Manual generator mode: do not fire prompts, hold position, or click buttons.
	-- Just wait for the player to solve it and Generatordone to become true.
	state.releaseGenHold()
	state.chest.genProbe = "manual generator - waiting for player"
	local waited = 0
	while true do
		local live = workspace:FindFirstChild(genName)
		if not live then
			return finish("missing")
		end
		local lb = live:FindFirstChild("Electrical Box With Lever")
		local m = lb and lb:FindFirstChild("Main")
