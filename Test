					end
					local cp = slot:FindFirstChildWhichIsA("ProximityPrompt", true)
					local proxim = false
					local held = false
					local afterInput = "-"
					for attempt = 1, 3 do
						if cp then
							proxim = promptInstant(cp) == true or proxim
						end
						task.wait(0.15)
						held = holdSlotInput(slot) or held
						task.wait(0.25)
						pcall(function()
							afterInput = tostring(word and word.Value or "-")
						end)
						if afterInput == letter then
							break
						end
						if codeTool and codeTool.Parent ~= LocalPlayer.Character then
							pcall(function()
								codeTool.Parent = LocalPlayer.Character
							end)
						end
					end
					local okSet = afterInput == letter
					if word and not okSet then
						pcall(function()
							word.Value = letter
							okSet = word.Value == letter
						end)
					end
					if okSet then
						placed += 1
					end
					stopToolHold()
					if codeTool then
						if okSet then
							state.codeToolsUsed[codeTool] = true
						end
						state.releaseCodeTool(codeTool)
					end
					mark("code slot " .. slotName .. "=" .. letter
						.. " before=" .. before
						.. " afterInput=" .. afterInput
						.. " set=" .. tostring(okSet)
						.. " proxim=" .. tostring(proxim)
						.. " hold=" .. tostring(held)
						.. " tool=" .. tostring(codeTool and codeTool.Name or "-"))
				end
			end
			return placed == #CODE_SLOT_LETTERS
		end
		state.trackCodeTools(true)
		local handled = {}
		local handleCount = 0
		while handleCount < #codeParts do
			if not TMS_EVENT_KEEP.eventWaitAlive() then
				note("Codeparts", "aborted")
				break
			end
			if TMS_EVENT_KEEP.eventShouldAbort() then
				note("Codeparts", "aborted")
				break
			end
			if waited >= TMS_EVENT_KEEP.EVENT_CODE_TIMEOUT then
