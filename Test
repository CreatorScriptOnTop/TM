end
local function startPromptHelper()
	if state.prompts.helperConn then
		return
	end
	if not state.prompts.scanDone then
		state.prompts.scanDone = true
		task.spawn(function()
			local stack, visits = { workspace }, 0
			while #stack > 0 and visits < 60000 do
				local inst = table.remove(stack)
				visits = visits + 1
				if inst:IsA("ProximityPrompt") then
					trackPrompt(inst)
				elseif inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Folder") then
					for _, child in ipairs(inst:GetChildren()) do
						stack[#stack + 1] = child
					end
				end
				if visits % 4000 == 0 then
					task.wait()
				end
			end
			enforceAllPrompts()
		end)
	end
	state.prompts.helperConn = workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("ProximityPrompt") then
			trackPrompt(inst)
			enforcePrompt(inst)
		end
	end)
	local last = 0
	state.prompts.helperConn2 = RunService.RenderStepped:Connect(function()
		local now = os.clock()
		if now - last < 1 then
			return
		end
		last = now
		if not state.prompts.instantHold and not state.prompts.extraRange then
			return
		end
		enforceAllPrompts()
	end)
end
local function stopPromptHelper()
	if state.prompts.helperConn then
		state.prompts.helperConn:Disconnect()
		state.prompts.helperConn = nil
	end
	if state.prompts.helperConn2 then
		state.prompts.helperConn2:Disconnect()
		state.prompts.helperConn2 = nil
	end
end
