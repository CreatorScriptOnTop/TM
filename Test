	local function doorCandidates(root)
		local out = {}
		local function consider(obj)
			if not obj or TMS_EVENT_KEEP.eventIsSelf(obj) then
				return
			end
			if not string.find(string.upper(obj.Name), "DOOR", 1, true) then
				return
			end
			local part = TMS_EVENT_KEEP.eventPart(obj)
			if not part or not part.Parent then
				return
			end
			local dist = (part.Position - root.Position).Magnitude
			if dist <= 250 then
