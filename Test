	local function looksLike(inst)
		if not inst:IsA("BasePart") and not inst:IsA("Model") and not inst:IsA("Tool") then
			return false
		end
		if isFragmentName(inst.Name) then
			return true
		end
		if isJunk(inst) then
			return false
		end
		local prompt = promptOf(inst)
		return prompt ~= nil and isTakePrompt(prompt)
	end
	local function partOf(inst)
		if inst:IsA("BasePart") then
			return inst
		end
		if inst:IsA("Tool") then
			local handle = inst:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				return handle
			end
		end
		local prompt = promptOf(inst)
		local held = prompt and prompt.Parent
