do
	local TabTheme = Window:Tab({ Title = "Theme", Icon = "palette" })
	local LOOK_FILE = "tms_theme.txt"
	local http = game:GetService("HttpService")
	local WALLPAPERS = {
		Midnight = { Color3.fromRGB(26, 30, 74), Color3.fromRGB(48, 24, 78) },
		Sunset = { Color3.fromRGB(84, 24, 56), Color3.fromRGB(140, 62, 28) },
		Ember = { Color3.fromRGB(92, 46, 16), Color3.fromRGB(134, 96, 22) },
		Ocean = { Color3.fromRGB(14, 44, 74), Color3.fromRGB(20, 86, 96) },
		Forest = { Color3.fromRGB(20, 54, 36), Color3.fromRGB(74, 96, 34) },
		Candy = { Color3.fromRGB(92, 30, 78), Color3.fromRGB(58, 34, 108) },
		Mono = { Color3.fromRGB(38, 38, 42), Color3.fromRGB(88, 88, 94) },
		Rainbow = {
			Color3.fromRGB(92, 26, 30),
			Color3.fromRGB(94, 74, 20),
			Color3.fromRGB(24, 74, 40),
			Color3.fromRGB(22, 48, 96),
			Color3.fromRGB(64, 28, 96),
		},
		Halloween = {
			Color3.fromRGB(92, 30, 12),
			Color3.fromRGB(64, 18, 78),
			Color3.fromRGB(24, 12, 38),
		},
		Christmas = {
			Color3.fromRGB(18, 66, 42),
			Color3.fromRGB(112, 28, 32),
			Color3.fromRGB(232, 240, 245),
		},
	}
	local WALLPAPER_NAMES = { "None", "Midnight", "Sunset", "Ember", "Ocean", "Forest", "Candy", "Mono", "Rainbow", "Halloween", "Christmas" }
	if state.look.wallpaper ~= "None" and not WALLPAPERS[state.look.wallpaper] then
		state.look.wallpaper = "None"
	end
	local themeNames
	do
		local seen = { Dark = true }
		local names = { "Dark" }
		local ok, themes = pcall(function()
			return WindUI:GetThemes()
		end)
		if ok and type(themes) == "table" then
			for name in pairs(themes) do
				if type(name) == "string" and not seen[name] then
					seen[name] = true
					names[#names + 1] = name
				end
			end
		end
		table.sort(names, function(a, b)
			if a == b then
				return false
			end
			if a == "Dark" then
				return true
			end
			if b == "Dark" then
				return false
			end
			return a:lower() < b:lower()
		end)
		themeNames = names
	end
	local mainUi = Window.UIElements and Window.UIElements.Main
	local bg = mainUi and (mainUi:FindFirstChild("Background")
		or (mainUi:IsA("GuiObject") and mainUi or nil))
	local wallGradient
	local overriding = false
	local hue = 0
	local function themeColour()
		local ok, themes = pcall(function()
			return WindUI:GetThemes()
		end)
		if not (ok and type(themes) == "table") then
			return nil
		end
		local name = state.look.theme
		local okName, current = pcall(function()
			return WindUI:GetCurrentTheme()
		end)
		if okName and type(current) == "string" then
			name = current
		end
		local theme = themes[name]
		if theme and typeof(theme.Background) == "Color3" then
			return theme.Background
		end
		return nil
	end
	local function releaseGradient()
		if wallGradient and wallGradient.Parent then
			wallGradient.Parent = nil
		end
	end
	local function ensureGradient()
		if not bg then
			return nil
		end
		local library = bg:FindFirstChild("LibraryGradient")
		if library then
			library:Destroy()
		end
		if not wallGradient then
			wallGradient = Instance.new("UIGradient")
			wallGradient.Name = "TMSWallpaper"
		end
		if wallGradient.Parent ~= bg then
			wallGradient.Parent = bg
		end
		wallGradient.Enabled = true
		wallGradient.Rotation = 90
		return wallGradient
	end
	local function paint()
		local look = state.look
		local preset = WALLPAPERS[look.wallpaper]
		if not (look.rgb or preset or look.accent) then
			if overriding then
				overriding = false
				releaseGradient()
				pcall(function()
					WindUI:SetTheme(look.theme)
				end)
			end
			return
		end
		local gradient = ensureGradient()
		if not gradient then
			return
		end
		overriding = true
		bg.ImageColor3 = Color3.new(1, 1, 1)
		local brightness = look.brightness
		if look.rgb then
			local keys = {}
			for step = 0, 4 do
				local time = step / 4
				keys[#keys + 1] = ColorSequenceKeypoint.new(
					time,
					Color3.fromHSV((hue + time * 0.45) % 1, 0.72, 0.32 + 0.26 * brightness)
				)
			end
			gradient.Color = ColorSequence.new(keys)
		elseif preset then
			local keys = {}
			for index = 1, #preset do
				local time = #preset > 1 and (index - 1) / (#preset - 1) or 0
				local colour = preset[index]
				keys[#keys + 1] = ColorSequenceKeypoint.new(
					time,
					Color3.new(colour.R * brightness, colour.G * brightness, colour.B * brightness)
				)
			end
			gradient.Color = ColorSequence.new(keys)
		else
			gradient.Color = ColorSequence.new(look.accent)
		end
	end
	local function saveLook()
		local accent
		if state.look.accent then
			accent = string.format(
				"%d,%d,%d",
				math.floor(state.look.accent.R * 255 + 0.5),
				math.floor(state.look.accent.G * 255 + 0.5),
				math.floor(state.look.accent.B * 255 + 0.5)
			)
		end
		local ok, encoded = pcall(function()
			return http:JSONEncode({
				theme = state.look.theme,
				wallpaper = state.look.wallpaper,
				season = state.look.season,
				rgb = state.look.rgb,
				brightness = state.look.brightness,
				accent = accent,
			})
		end)
		if ok and type(encoded) == "string" then
			pcall(function()
				TMS.write(LOOK_FILE, encoded)
			end)
		end
	end
	local themeDropdown = nil
	local wallpaperDropdown = nil
	local rgbToggle = nil
	local brightnessSlider = nil
	local seasonDropdown = nil
	local seasonParticlesToggle = nil
	local SectionTheme = TabTheme:Section({ Title = "Theme", Icon = "paintbrush" })
	themeDropdown = SectionTheme:Dropdown({
		Title = "Theme",
		Values = themeNames,
		Value = state.look.theme,
		Callback = function(v)
			if type(v) ~= "string" then
				return
			end
			state.look.theme = v
			pcall(function()
				WindUI:SetTheme(v)
			end)
			paint()
			saveLook()
		end,
	})
	SectionTheme:Colorpicker({
		Title = "Window colour",
		Value = state.look.accent or themeColour() or Color3.fromRGB(24, 24, 28),
		Callback = function(v)
			if typeof(v) ~= "Color3" then
				return
			end
			state.look.accent = v
			paint()
			saveLook()
		end,
	})
	rgbToggle = SectionTheme:Toggle({
		Title = "RGB mode",
		Value = state.look.rgb,
		Callback = function(v)
			if type(v) ~= "boolean" then
				return
			end
			state.look.rgb = v
			paint()
			saveLook()
		end,
