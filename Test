state.ascend.instaOnce = function()
	local b = workspace:FindFirstChild("Bosses") and workspace.Bosses:FindFirstChild("Ascend")
	if not b then
		notify("Insta Kill", "Ascend boss not found.", "alert-triangle")
		return false
	end
	local humB = b:FindFirstChildOfClass("Humanoid")
	if not humB or humB.Health <= 0 then
		notify("Insta Kill", "Boss is already down.", "check")
		return false
	end
	local plr = game:GetService("Players").LocalPlayer
	local stanceZero = false
	local ai = b:FindFirstChild("AI")
	local misc = ai and ai:FindFirstChild("Stuff") and ai.Stuff:FindFirstChild("Misc")
	local stamina = misc and misc:FindFirstChild("Stamina")
	if stamina and type(stamina.Value) == "number" then
		stanceZero = stamina.Value <= 0
	else
		local pg = plr:FindFirstChildOfClass("PlayerGui")
		local bb = pg and pg:FindFirstChild("BossBar")
		local bar = bb and bb:FindFirstChild("MainFrame") and bb.MainFrame:FindFirstChild("BossBar")
		bar = bar and bar:FindFirstChild("StaminaBarFrame") and bar:FindFirstChild("Bar")
		if bar then stanceZero = bar.Size.X.Scale <= 0.01 end
	end
	if not stanceZero then
		notify("Insta Kill", "Wait until the stamina bar is empty.", "alert-triangle")
		return false
	end
	local ok = pcall(function()
		humB.Health = 0
	end)
	if ok then
		state.ascend.m1s += 1
		state.ascend.instaKills += 1
		notify("Insta Kill", "Fired once.", "skull")
		return true
	end
	notify("Insta Kill", "Could not damage the boss.", "alert-triangle")
	return false
end
