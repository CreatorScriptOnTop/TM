						local startRemote = grabAnim and grabAnim:FindFirstChild("Start")
						if startRemote then
							startRemote:FireServer()
						end
					end
				end)
				pcall(function()
					local tool = char:FindFirstChild("16")
					local remote = tool and tool:FindFirstChild("LocalScript") and tool.LocalScript:FindFirstChild("RemoteEvent")
					if remote then
						remote:FireServer(targetChar)
					end
				end)
				if not cachedWeapon or not cachedWeapon.Parent then
					local backpack = player:FindFirstChild("Backpack")
					for _, loc in pairs({char, backpack}) do
						if loc then
							for _, item in pairs(loc:GetChildren()) do
								local n = item.Name
								if n == "Rapid Barrage" then
									cachedWeapon = item
									break
								elseif n == "Real Knife" or n:match("^%d+$") then
									if item:FindFirstChild("Attacks") then
										cachedWeapon = item
										break
									end
								end
							end
							if cachedWeapon then break end
						end
					end
				end
				if cachedWeapon then
					if cachedWeapon.Name == "Rapid Barrage" then
						local grabAnim = cachedWeapon:FindFirstChild("GrabAnimation")
						local startRemote = grabAnim and grabAnim:FindFirstChild("Start")
						if startRemote then
							startRemote:FireServer()
						end
					else
						pcall(function() cachedWeapon.Attacks:FireServer() end)
					end
				end
			end)
		else
			tpPlayerRunning = false
			if tpPlayerConnection then tpPlayerConnection:Disconnect() tpPlayerConnection = nil end
		end
	end,
})
