		for _, inst in ipairs(list) do
			if inst:IsA("ProximityPrompt") then
				if isTakePrompt(inst) then
					local holder = inst.Parent
					if holder and (holder:IsA("BasePart") or holder:IsA("Model") or holder:IsA("Tool")) then
						collect(holder)
					else
						collect(holder and holder.Parent)
					end
				end
			elseif inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Tool") then
				if isFragmentName(inst.Name) then
					collect(inst)
				end
			end
		end
	end
