local function scanTeleports(quiet)
	teleportScanning = true
	local found = {}
	local stack = {}
	for _, child in ipairs(workspace:GetChildren()) do
		stack[#stack + 1] = { i = child, d = 1 }
	end
	local visits = 0
	while #stack > 0 do
		local node = table.remove(stack)
		visits = visits + 1
		if visits > 60000 then
			break
		end
		local inst = node.i
		if inst:IsA("ProximityPrompt") then
			local action = tostring(inst.ActionText or "")
			local lower = string.lower(action)
			if lower == "enter" or lower == "exit" or string.find(lower, "teleport", 1, true) then
				local part = inst.Parent
				if part and part:IsA("BasePart") then
					local key = teleportKey(action, inst.ObjectText, part.Name)
					local group = found[key]
					if not group then
						group = {
							action = action,
							object = tostring(inst.ObjectText or ""),
							doorName = part.Name,
							position = part.Position,
							prompts = {},
						}
						found[key] = group
					end
					group.prompts[#group.prompts + 1] = inst
					if #group.prompts == 1 then
						group.position = part.Position
					end
				end
			end
		end
		if node.d < 16 then
			local ok, kids = pcall(function()
				return inst:GetChildren()
			end)
			if ok then
				for _, kid in ipairs(kids) do
					stack[#stack + 1] = { i = kid, d = node.d + 1 }
				end
			end
		end
		if visits % 4000 == 0 then
			task.wait()
		end
	end
	local count = 0
	for key, group in pairs(found) do
		teleportGroups[key] = group
		count = count + 1
		addTeleportButton(key, group)
	end
	teleportScanning = false
	state.debug.tpFound = count
	if not quiet then
		notify(
			"Teleport",
			count > 0
				and string.format("%d destination(s) found.", count)
				or "No teleport doors found yet - some areas may be unloaded.",
			count > 0 and "check" or "alert-triangle"
		)
	end
	return count
end
