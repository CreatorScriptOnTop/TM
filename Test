			notify(
				"Server hop",
				"No other public server has space. Using Rejoin fresh instead.",
				"alert-triangle"
			)
			rejoinFresh()
			return
		end
		for i = #pool, 2, -1 do
			local j = math.random(i)
			pool[i], pool[j] = pool[j], pool[i]
		end
		local target = pool[1]
		local tpOk, success, result, message = pcall(function()
			return TeleportService:TeleportToPlaceInstance(
				game.PlaceId,
				target,
				LocalPlayer,
				{ setLoadingScreen = true }
			)
		end)
		if not tpOk then
			notify("Server hop", "Error: " .. tostring(success), "alert-triangle")
			return
