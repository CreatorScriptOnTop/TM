end
state.runMonsterCounter = function()
	if state.chest.monsterCounterRunning then
		return
	end
	state.chest.monsterCounterRunning = true
	watcherFled = {}
	local POLL = 0.1
	local CONTACT_HOLD = 0.5
	local FLEE_RANGE = 120
	local FLEE_COOLDOWN = 2
	local lastFlee = -99
	local preFate = nil
	local fateGuiBaseline = nil
	local fatePending = false
	local fateCaughtAt = 0
	local fateDoorAt = 0
	local fateHandled = false
	local fateDone = {}
	local fateModel = nil
	local noMoreHandled = false
	local noMoreContactAt = 0
	local noMoreDone = {}
	local noMoreModel = nil
	local noMoreExitPlaced = false
	local noMoreReturnCFrame = nil
	local hopeTouched = {}
	local eyeTouched = {}
	local function alive()
		local hp = TMS_EVENT_KEEP.eventHealth()
		return hp ~= nil and hp > 0
	end
	local function waitAlive()
		local waited = 0
		while state.chest.monsterCounter and not alive() and waited < 90 do
			task.wait(0.5)
			waited += 0.5
		end
		return alive()
	end
	local function kindOf(name)
		local n = TMS_EVENT_KEEP.entityNormalize(name or "")
		if n == "GRIEF" then
			return "GRIEF"
		end
		if n == "SORROW" or n == "SORROWED" then
			return "SORROW"
		end
		if n == "WATCHER" or n == "WATCHERR" then
			return "WATCHER"
		end
		if n == "NOMOR3" or n == "NOMORE" or n == "NOMOR" then
			return "NOMORE"
		end
		if n == "EYESEE" or n == "EYE" then
			return "EYESEE"
		end
		if n == "FATE" then
			return "FATE"
		end
		if n == "NOHOPE" or n == "NOHOP" then
			return "NOHOPE"
		end
		return nil
	end
	local function collect()
		local out = {}
		local function add(obj)
			local kind = kindOf(obj.Name)
			if not kind or TMS_EVENT_KEEP.eventIsSelf(obj) then
				return
			end
			local part = nil
			if obj:IsA("Model") then
				local primary = obj.PrimaryPart
				local rootPart = obj:FindFirstChild("HumanoidRootPart")
				local headPart = obj:FindFirstChild("Head")
				if primary and primary:IsA("BasePart") then
					part = primary
				elseif rootPart and rootPart:IsA("BasePart") then
					part = rootPart
				elseif headPart and headPart:IsA("BasePart") then
					part = headPart
				end
			end
			part = part or TMS_EVENT_KEEP.eventPart(obj)
			if not part or not part.Parent then
				return
			end
			local hum = obj:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health <= 0 then
				return
			end
			out[kind] = out[kind] or {}
			out[kind][#out[kind] + 1] = { model = obj, part = part, hum = hum }
		end
		local function walk(obj, depth)
			if depth > 3 then
				return
			end
			for _, child in ipairs(obj:GetChildren()) do
				if child:IsA("Model") or child:IsA("BasePart") then
					add(child)
				end
				if child:IsA("Folder") or child:IsA("Model") then
					walk(child, depth + 1)
				end
			end
		end
		walk(workspace, 0)
		return out
	end
	local function closest(list, pos)
		local best, bestDist = nil, math.huge
		if not list then
			return best, bestDist
		end
		for _, entry in ipairs(list) do
			local dist = (entry.part.Position - pos).Magnitude
			if dist < bestDist then
				best, bestDist = entry, dist
			end
		end
		return best, bestDist
	end
	local function face(part, away)
		if not part or not part.Parent then
			return false
		end
		local cam = workspace.CurrentCamera
		local root = TMS_EVENT_KEEP.eventRoot()
		local origin = cam and cam.CFrame.Position
			or (root and (root.Position + Vector3.new(0, 2, 0)) or nil)
		if not origin then
			return false
		end
		local dir = part.Position - origin
		if away then
			dir = -dir
		end
		if dir.Magnitude < 0.001 then
			dir = Vector3.new(0, 0, -1)
		end
		if cam then
			pcall(function()
				cam.CFrame = CFrame.lookAt(origin, origin + dir)
			end)
		end
		if root then
			local flat = Vector3.new(dir.X, 0, dir.Z)
			if flat.Magnitude > 0.001 then
				pcall(function()
					root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
				end)
			end
		end
		state.chest.monsterLooks += 1
		return true
	end
	local function place(part, exact, keepLook)
		local root = TMS_EVENT_KEEP.eventRoot()
		if not root or not part or not part.Parent then
			return false
		end
		local look = keepLook and root.CFrame.LookVector or part.CFrame.LookVector
		local dest = exact and part.CFrame or (part.CFrame + TMS_EVENT_KEEP.EVENT_SAFESPOT_HOLD)
		for i = 1, TMS_EVENT_KEEP.EVENT_TP_ATTEMPTS do
			local ok = pcall(function()
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				root.CFrame = CFrame.lookAt(dest.Position, dest.Position + look)
			end)
			if not ok then
				return false
			end
			if i < TMS_EVENT_KEEP.EVENT_TP_ATTEMPTS then
				task.wait(TMS_EVENT_KEEP.EVENT_TP_SETTLE)
			end
		end
		return true
	end
	local HOLD_BIND = "TMSMonsterCounterHold"
	local holdCFrame = nil
	local holdBound = false
	local function applyHold()
		local dest = holdCFrame
		local root = TMS_EVENT_KEEP.eventRoot()
		if not dest or not root or not root.Parent then
			return
		end
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = CFrame.lookAt(dest.Position, dest.Position + root.CFrame.LookVector)
		end)
	end
	local function releaseHold()
		if holdBound then
			pcall(function()
				RunService:UnbindFromRenderStep(HOLD_BIND)
			end)
			holdBound = false
		end
		holdCFrame = nil
	end
	local function holdAt(cframe)
		if not cframe then
			return false
		end
		holdCFrame = cframe
		if not holdBound then
			pcall(function()
				RunService:UnbindFromRenderStep(HOLD_BIND)
			end)
			local ok = pcall(function()
				RunService:BindToRenderStep(HOLD_BIND, Enum.RenderPriority.Camera.Value + 4, applyHold)
			end)
			holdBound = ok == true
		end
		applyHold()
		return true
	end
	local function mazeCaught()
		local char = LocalPlayer.Character
		local bool = char and char:FindFirstChild("Mazestuff")
		return bool ~= nil and bool.Value == true
	end
	local function mazeActive()
		if TMS_EVENT_KEEP.mazeIsActive() then
			return true
		end
		if mazeCaught() then
			return true
		end
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		local gui = pg and pg:FindFirstChild("NoMore_TimerGui")
		if not gui then
			return false
		end
		local foundTimer = false
